//@version=5
strategy(
  title="XAUUSD Multi-Strategy",
  overlay=true,
  initial_capital=10000,
  default_qty_type=strategy.percent_of_equity,
  default_qty_value=100,
  commission_type=strategy.commission.percent,
  commission_value=0.01,
  slippage=2
)

// --- Inputs ---
fastLen   = input.int(9,   "Fast EMA")
midLen    = input.int(21,  "Mid EMA")
slowLen   = input.int(50,  "Slow EMA")
rsiLen    = input.int(14,  "RSI Length")
rsiOB     = input.int(70,  "RSI Overbought")
rsiOS     = input.int(30,  "RSI Oversold")
atrMult   = input.float(2.0, "ATR Multiplier (Stop)")
atrLen    = input.int(14,   "ATR Length")
useRsi    = input.bool(true, "Use RSI Filter")
useTrend  = input.bool(true, "Use Trend Filter (EMA 200)")

// --- Indicators ---
emaFast = ta.ema(close, fastLen)
emaMid  = ta.ema(close, midLen)
emaSlow = ta.ema(close, slowLen)
ema200  = ta.ema(close, 200)
rsi     = ta.rsi(close, rsiLen)
atr     = ta.atr(atrLen)

// --- Trend Direction ---
trendUp   = close > ema200
trendDown = close < ema200

// --- Entry Conditions ---
buyCond1  = ta.crossover(emaFast, emaMid)
buyCond2  = ta.crossunder(emaFast, emaMid)

// RSI filter
rsiBull = not useRsi or rsi < rsiOB
rsiBear = not useRsi or rsi > rsiOS

// Trend filter
trendBull = not useTrend or trendUp
trendBear = not useTrend or trendDown

longCondition   = buyCond1 and rsiBull and trendBull
shortCondition  = buyCond2 and rsiBear and trendBear

// --- Execution ---
if longCondition
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", stop=close - atr * atrMult)

if shortCondition
    strategy.entry("Short", strategy.short)
    strategy.exit("XS", "Short", stop=close + atr * atrMult)

// --- Plots ---
plot(emaFast, "Fast EMA", color.blue)
plot(emaMid,  "Mid EMA",  color.orange)
plot(emaSlow, "Slow EMA", color.red)
plot(ema200,  "EMA 200",  trendUp ? color.green : color.red, 2)
hline(0, "Zero", color.gray)
