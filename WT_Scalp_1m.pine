//@version=6
// OPTIMIZED WAVE Trend Scalp Strategy for 1-minute XAUUSDT
// Based on Python optimization results (GC=F data scaled to XAUUSDT prices)
// Parameters optimized for best risk-adjusted returns

strategy(
    "WT_Scalp_1m",
    overlay=false,
    pyramiding=0,
    initial_capital=10000,
    commission_type=strategy.commission.percent,
    commission_value=0.04,
    slippage=1
)

// ── FIXED PARAMETERS (Optimized) ──
n1  := 9      // WT Channel Length
n2  := 25      // WT Average Length  
ob1 := 60      // OverBought 1
ob2 := 40      // OverBought 2
os1 := -55     // OverSold 1
os2 := -50     // OverSold 2
atrLen  := 5   // ATR Length
tpMult  := 1.5 // TP xATR

// ── CRITICAL MARTINGALE SETTINGS ──
bQty   := 0.2   // Base Qty
qMult  := 1.5   // Quantity Multiplier
maxLvl := 4     // Maximum Martingale Levels

// ── WAVE TREND CALCULATION ──
ap  = hlc3
esa = ta.ema(ap, n1)
d   = ta.ema(math.abs(ap - esa), n1)
ci  = (ap - esa) / (0.015 * d)
tci = ta.ema(ci, n2)
wt1 = tci
wt2 = ta.sma(wt1, 4)

// ── ENTRY SIGNALS ──
longSignal  = ta.crossover(wt1, wt2)
shortSignal = ta.crossunder(wt1, wt2)

// ── ATR ──
atr = ta.atr(atrLen)

// ── MARTINGALE STATE ──
var int lossCount = 0
var float entryPx = 0.0

// ── ENTRIES AND EXITS ──
if longSignal and strategy.position_size <= 0
    int lvl = math.min(lossCount, maxLvl - 1)
    float size = bQty * math.pow(qMult, lvl)
    float maxCost = strategy.equity * 0.3
    int qty = int(math.floor(maxCost / (close * size)))
    qty := math.max(qty, 1)
    entryPx := close
    strategy.entry("L", strategy.long, qty = qty)
    strategy.exit("Lx", "L", limit = entryPx + atr * tpMult, stop = entryPx - atr * tpMult)

if shortSignal and strategy.position_size >= 0
    int lvl = math.min(lossCount, maxLvl - 1)
    float size = bQty * math.pow(qMult, lvl)
    float maxCost = strategy.equity * 0.3
    int qty = int(math.floor(maxCost / (close * size)))
    qty := math.max(qty, 1)
    entryPx := close
    strategy.entry("S", strategy.short, qty = qty)
    strategy.exit("Sx", "S", limit = entryPx - atr * tpMult, stop = entryPx + atr * tpMult)

// ── LOSS COUNT MANAGEMENT ──
if strategy.position_size[1] != 0 and strategy.position_size == 0
    if strategy.equity >= strategy.equity[1]
        lossCount := 0
    else
        lossCount := math.min(lossCount + 1, maxLvl - 1)

// ── VISUAL ELEMENTS ──
hline(0, "Zero", color.gray)
hline(ob1, "OB1", color.red)
hline(os1, "OS1", color.green)
hline(ob2, "OB2", color.red, linestyle=hline.style_dotted)
hline(os2, "OS2", color.green, linestyle=hline.style_dotted)

plot(wt1, "WT1", color.green)
plot(wt2, "WT2", color.red)
fill(plot(wt1), plot(wt2), wt1 > wt2 ? color.new(color.green, 80) : color.new(color.red, 80))

plotshape(longSignal, "L", shape.triangleup, location.bottom, color.green)
plotshape(shortSignal, "S", shape.triangledown, location.top, color.red)
