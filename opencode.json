{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "lighthouse": {
      "type": "local",
      "command": ["npx", "-y", "@danielsogl/lighthouse-mcp@latest"],
      "enabled": true
    },
    "sqlite": {
      "type": "local",
      "command": ["uvx", "mcp-server-sqlite", "--db-path", "backend/atos.db"],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git commit*": "ask",
      "git push --force*": "deny",
      "*Stop-Process*": "ask",
      "*kill*": "ask",
      "*Restart-Process*": "ask",
      "*uvicorn*": "ask",
      "pip install*": "ask",
      "Remove-Item -Recurse*": "deny",
      "rm -rf*": "deny"
    }
  }
}
