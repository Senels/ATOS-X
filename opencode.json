{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "provider": {
    "tokenrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TokenRouter",
      "options": {
        "baseURL": "https://api.tokenrouter.com/v1",
        "apiKey": "{env:TOKENROUTER_API_KEY}"
      },
      "models": {
        "moonshotai/kimi-k3-free": {
          "name": "Kimi K3 Free",
          "limit": { "context": 262144, "output": 65536 },
          "tool_call": true, "reasoning": true, "attachment": true
        },
        "deepseek/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (1M)",
          "limit": { "context": 1000000, "output": 65536 },
          "tool_call": true, "reasoning": true
        },
        "deepseek/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (1M)",
          "limit": { "context": 1000000, "output": 65536 },
          "tool_call": true, "reasoning": true
        },
        "anthropic/claude-sonnet-4.5": {
          "name": "Claude Sonnet 4.5",
          "limit": { "context": 200000, "output": 65536 },
          "tool_call": true, "reasoning": true
        },
        "openai/gpt-5.4": {
          "name": "GPT-5.4",
          "limit": { "context": 131072, "output": 32768 },
          "tool_call": true, "reasoning": true
        },
        "moonshotai/kimi-k2.7-code": {
          "name": "Kimi K2.7 Code (256K)",
          "limit": { "context": 262144, "output": 65536 },
          "tool_call": true, "reasoning": true, "attachment": true
        },
        "qwen/qwen3.7-max": {
          "name": "Qwen 3.7 Max (256K)",
          "limit": { "context": 262144, "output": 65536 },
          "tool_call": true, "reasoning": true, "attachment": true
        }
      }
    }
  },
  "mcp": {
    "lighthouse": {
      "type": "local",
      "command": ["C:/Users/svkts/AppData/Local/Programs/Python/Python311/python.exe", "C:/Users/svkts/OneDrive/Belgeler/Default Project/.opencode/scripts/lighthouse_mcp.py"],
      "enabled": true
    },
    "sqlite": {
      "type": "local",
      "command": ["uvx", "--from", "mcp-server-sqlite", "--with", "mcp<2", "mcp-server-sqlite", "--db-path", "backend/atos.db"],
      "enabled": true
    },
    "binance": {
      "type": "local",
      "command": ["C:/Users/svkts/AppData/Local/Programs/Python/Python311/python.exe", "C:/Users/svkts/OneDrive/Belgeler/Default Project/.opencode/scripts/binance_mcp.py"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    }
  },
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "basedpyright": {
      "command": ["C:/Users/svkts/AppData/Local/Programs/Python/Python311/Scripts/basedpyright-langserver.exe", "--stdio"],
      "extensions": [".py", ".pyi"]
    },
    "html": {
      "command": ["C:/Users/svkts/AppData/Roaming/npm/vscode-html-language-server.cmd", "--stdio"],
      "extensions": [".html"]
    },
    "css": {
      "command": ["C:/Users/svkts/AppData/Roaming/npm/vscode-css-language-server.cmd", "--stdio"],
      "extensions": [".css"]
    },
    "json": {
      "command": ["C:/Users/svkts/AppData/Roaming/npm/vscode-json-language-server.cmd", "--stdio"],
      "extensions": [".json"]
    },
    "ruff": {
      "command": ["C:/Users/svkts/AppData/Local/Programs/Python/Python311/Scripts/ruff.exe", "server"],
      "extensions": [".py"]
    }
  },
  "formatter": {
    "ruff": {
      "command": ["C:/Users/svkts/AppData/Local/Programs/Python/Python311/Scripts/ruff.exe", "format", "$FILE"],
      "extensions": [".py"]
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", ".venv/**", ".git/**", "legacy/**", "backend/futures_1m_data/**", ".opencode/node_modules/**"]
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git commit*": "ask",
      "git push --force*": "deny",
      "*Stop-Process*": "ask",
      "*kill*": "ask",
      "*Restart-Process*": "ask",
      "*uvicorn*": "ask",
      "pip install*": "ask",
      "Remove-Item -Recurse*": "deny",
      "rm -rf*": "deny"
    },
    "mcp__sqlite__write_query": "deny",
    "mcp__sqlite__create_table": "deny",
    "mcp__sqlite__append_insight": "deny",
    "mcp__binance__place_order*": "ask",
    "mcp__binance__cancel_order*": "ask",
    "mcp__binance__cancel_all_orders*": "ask"
  }
}
