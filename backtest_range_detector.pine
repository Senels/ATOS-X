//@version=5
strategy(title="Range Detector — XAUUSDT", overlay=true,
     initial_capital=10000, default_qty_type=strategy.fixed,
     commission_type=strategy.commission.percent, commission_value=0.04,
     pyramiding=0)

// ── Inputs ──
rd_length  = input.int(14, "RD Length", minval=3, maxval=200)
rd_mult    = input.float(1.5, "RD Multiplier", step=0.1, minval=0.5, maxval=10)
rd_atr_len = input.int(10, "RD ATR Length", minval=3, maxval=100)
rd_smooth  = input.int(1, "Smoothing", minval=1, maxval=20)
sl_atr     = input.float(1.5, "SL (ATR)", step=0.1, minval=0.5)
tp_atr     = input.float(3.0, "TP (ATR)", step=0.1, minval=0.5)
leverage   = input.int(10, "Leverage", minval=1, maxval=100)
pos_pct    = input.float(10, "Position %", step=1, minval=1, maxval=100) / 100

// ── Bands ──
tr_val   = ta.tr
atr_val  = ta.rma(tr_val, rd_atr_len)
hh       = ta.highest(high, rd_length)
ll       = ta.lowest(low, rd_length)

raw_center = (hh + ll) / 2
center   = rd_smooth > 1 ? ta.sma(raw_center, rd_smooth) : raw_center
upper    = center + atr_val * rd_mult
lower    = center - atr_val * rd_mult

// ── Signals ──
buy_sig  = close > upper and close > open
sell_sig = close < lower and close < open
flat     = strategy.position_size == 0
in_long  = strategy.position_size > 0
in_short = strategy.position_size < 0

// ── Capture entry price & ATR ──
var float entry_px  = na
var float entry_atr = na

if buy_sig and flat
    entry_px  := close
    entry_atr := atr_val
if sell_sig and flat
    entry_px  := close
    entry_atr := atr_val

if flat
    entry_px  := na
    entry_atr := na

// ── Position sizing ──
qty = (strategy.equity * pos_pct * leverage) / close

// ── Entries ──
if buy_sig and flat
    strategy.entry("Long", strategy.long, qty=qty)
if sell_sig and flat
    strategy.entry("Short", strategy.short, qty=qty)

// ── Reverse signal exit ──
if sell_sig and in_long
    strategy.close("Long")
if buy_sig and in_short
    strategy.close("Short")

// ── Fixed SL/TP ──
if in_long and not na(entry_atr)
    strategy.exit("XL", "Long",
         stop=entry_px - entry_atr * sl_atr,
         limit=entry_px + entry_atr * tp_atr)

if in_short and not na(entry_atr)
    strategy.exit("XS", "Short",
         stop=entry_px + entry_atr * sl_atr,
         limit=entry_px - entry_atr * tp_atr)

// ── Plot ──
plot(center, "Center", color.purple, 1)
plot(upper, "Upper", color.green, 1)
plot(lower, "Lower", color.red, 1)

bgcolor(buy_sig ? color.new(color.green, 85) : sell_sig ? color.new(color.red, 85) : na)
