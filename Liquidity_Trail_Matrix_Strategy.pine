//@version=6
// LIQUIDITY TRAIL MATRIX [WillyAlgoTrader] - Professional Edition
// Author:  Willy | WillyAlgoTrader
// Version: 2.0.0 — Strategy

strategy(
     title            = "Liquidity Trail Matrix [WillyAlgoTrader]",
     shorttitle       = "LTM",
     overlay          = true,
     max_bars_back    = 5000,
     initial_capital  = 10000,
     commission_type  = strategy.commission.percent,
     commission_value = 0.04,
     slippage         = 1,
     process_orders_on_close = true,
     pyramiding           = 5)

// ══════════════════════════════════════════════════════════
// 2. CONSTANTS
// ══════════════════════════════════════════════════════════
GRP_MAIN   = "Ana"
GRP_SIG    = "Sinyal"
GRP_PROF   = "Profil"
GRP_VISUAL = "Gorsel"
GRP_RISK   = "Risk"
GRP_DASH   = "Panel"
GRP_ALERT  = "Uyari"
GRP_COLORS = "Renk"
GRP_ADV    = "Gelismis"
GRP_PRO    = "Profesyonel"

INDICATOR_VERSION = "v2.0.0"
LINE_FORWARD_BARS = 20
LINE_UPDATE_BARS  = 5
LABEL_OFFSET_BARS = 1
FORM_LEN          = 10

// ══════════════════════════════════════════════════════════
// 3. INPUTS
// ══════════════════════════════════════════════════════════

// ── Trend Engine ──
bandPresetInput = input.string("Custom", "Bant Genisligi",
     options = ["Scalping", "Balanced", "Deep Trend", "Custom"],
     group   = GRP_MAIN,
      tooltip = "Custom: optimize edilmis (11.5x taban, 0.475 adim)")

baseMultInput = input.float(11.5, "Taban Carpani (xATR)", minval = 0.5, maxval = 15.0, step = 0.1,
     group   = GRP_MAIN,
      tooltip = "Optimize: 11.5")

bandStepInput = input.float(0.475, "Bant Araligi (oransal)", minval = 0.05, maxval = 1.0, step = 0.025,
     group   = GRP_MAIN)

atrLenInput = input.int(74, "ATR Uzunlugu", minval = 3, maxval = 120,
     group   = GRP_MAIN)

srcInput = input.source(close, "Kaynak",
     group   = GRP_MAIN)

flipBandStr = input.string("Balanced (Band 3)", "Donus Bandi",
     options = ["Fast (Band 2)", "Balanced (Band 3)", "Deep (Band 4)"],
     group   = GRP_MAIN)

htfInput = input.timeframe("", "Ust TF Yonu",
     group   = GRP_MAIN)

// ── Signals ──
minScoreInput = input.int(25, "Min Test Skoru (0-100)", minval = 0, maxval = 100,
     group   = GRP_SIG)

retestWindowInput = input.int(49, "Test Penceresi (bar)", minval = 1, maxval = 50,
     group   = GRP_SIG)

cooldownInput = input.int(16, "Sinyal Bekleme (bar)", minval = 0, maxval = 100,
     group   = GRP_SIG)

// ── Volume Profile ──
showProfileInput = input.bool(true, "Segment Hacim Profili", group = GRP_PROF)
profRowsInput = input.int(30, "Profil Satirlari", minval = 10, maxval = 100, group = GRP_PROF)
profWidthInput = input.int(34, "Profil Genisligi (bar)", minval = 10, maxval = 100, group = GRP_PROF)
maxProfBarsInput = input.int(500, "Maks Profil Bari", minval = 50, maxval = 2000, group = GRP_PROF)
showPocInput = input.bool(true, "POC Goster", group = GRP_PROF)
showVaInput = input.bool(true, "Deger Alani (70%)", group = GRP_PROF)
profLabelSizeInput = input.string("Small", "Profil Etiket Boyutu",
     options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = GRP_PROF)
showNodesInput = input.bool(true, "HVN / LVN Seviyeleri", group = GRP_PROF)

// ── Visual ──
themeInput = input.string("Auto", "Tema",
     options = ["Auto", "Dark", "Light"], group = GRP_VISUAL)
showBandsInput = input.bool(true, "Iz Bantlarini Goster", group = GRP_VISUAL)
showHeatInput = input.bool(true, "Bant Isi Haritasi", group = GRP_VISUAL)
showTrendPnlInput = input.bool(false, "Trend K/Z Goster", group = GRP_VISUAL)
showSignalsInput = input.bool(true, "Test Sinyallerini Goster", group = GRP_VISUAL)
showFlipLabelsInput = input.bool(true, "Donus Etiketlerini Goster", group = GRP_VISUAL)
signalFontSizeInput = input.string("Small", "Signal Etiket Boyutu",
     options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = GRP_VISUAL)
labelFontSizeInput = input.string("Small", "SL/TP Etiket Boyutu",
     options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = GRP_VISUAL)
showWatermarkInput = input.bool(true, "Filigran Goster", group = GRP_VISUAL)

// ── Risk Management ──
riskPresetInput = input.string("Balanced", "Risk On Ayari",
     options = ["Conservative", "Balanced", "Aggressive", "Scalping", "Custom"],
     group   = GRP_RISK)

atrLenRiskInput = input.int(4, "ATR Uzunlugu (Risk)", minval = 3, maxval = 80, group = GRP_RISK)
tpBaseMultInput = input.float(1.5, "TP Taban Carpani (xATR)", minval = 0.5, maxval = 5.0, step = 0.1, group = GRP_RISK)
tp1MultInput = input.float(0.9, "TP1 Carpani (xTaban)", minval = 0.5, maxval = 5.0, step = 0.1, group = GRP_RISK)
tp2MultInput = input.float(2.0, "TP2 Carpani (xTaban)", minval = 1.0, maxval = 10.0, step = 0.1, group = GRP_RISK)
tp3MultInput = input.float(3.0, "TP3 Carpani (xTaban)", minval = 1.5, maxval = 15.0, step = 0.1, group = GRP_RISK)

longLevInput = input.float(18.0, "Uzun Kaldirac", minval = 1.0, maxval = 20.0, step = 1.0, group = GRP_RISK,
     tooltip = "Properties -> Long Leverage alanina manuel girin")
shortLevInput = input.float(19.0, "Kisa Kaldirac", minval = 1.0, maxval = 20.0, step = 1.0, group = GRP_RISK,
     tooltip = "Properties -> Short Leverage alanina manuel girin")

reverseSignalInput = input.bool(false, "Sinyal Ters Cevir", group = GRP_RISK)
showTpInput = input.bool(true, "TP Cizgileri", group = GRP_RISK)
showTpLabelsInput = input.bool(true, "TP Etiketleri", group = GRP_RISK)
showPctOnLabelsInput = input.bool(true, "Etikette % Uzaklik", group = GRP_RISK)
entryLineStyleInput = input.string("Dotted", "Giris Cizgi Stili",
     options = ["Solid", "Dashed", "Dotted"], group = GRP_RISK)
tpLineStyleInput = input.string("Dashed", "TP Cizgi Stili",
     options = ["Solid", "Dashed", "Dotted"], group = GRP_RISK)

// ── Professional Risk ──
riskPerTradeInput = input.float(2.0, "Trade Basina Risk (%)", minval = 0.1, maxval = 10.0, step = 0.1, group = GRP_PRO,
     tooltip = "Her trade'de hesabin yuzde kacini riske atacaginiz.\n" +
               "Orn: %2 = 10.000$ hesapta max 200$ risk.\n" +
                "Pozisyon buyuklugu ATR bazli risk mesafesine gore otomatik hesaplanir.")

sessionFilterInput = input.string("London+NY", "Seans Filtresi",
     options = ["7/24", "London Only", "NY Only", "London+NY", "Asian Only"],
     group   = GRP_PRO,
      tooltip = "Sadece belirtilen seanslarda trade acar.\n" +
                "UTC saatleri:\n" +
                "London: 07:00-16:00\n" +
                "NY: 13:00-22:00\n" +
                "Asian: 00:00-09:00\n" +
                "London+NY: 07:00-22:00\n" +
                "Gold 1m icin onerilen: London+NY")

tp1ScalePctInput = input.float(30.0, "TP1'de Kapat %", minval = 0.0, maxval = 100.0, step = 5.0, group = GRP_PRO,
     tooltip = "TP1 vuruldugunda pozisyonun yuzde kacini kapatir.\n" +
               "Kalan TP2/TP3'e gider. %0 = olcekleme yok.")

tp2ScalePctInput = input.float(30.0, "TP2'de Kapat %", minval = 0.0, maxval = 100.0, step = 5.0, group = GRP_PRO,
     tooltip = "TP2 vuruldugunda kALAN pozisyonun yuzde kaci kapatilir.\n" +
               "Orn: ilk %30 kapandi, kalanin %30'u = toplamin %21'i.")

maxDailyLossInput = input.float(5.0, "Gunluk Max Kayip (%)", minval = 0.0, maxval = 20.0, step = 0.5, group = GRP_PRO,
     tooltip = "Gunluk % kayip bu degeri asarsa gun sonuna kadar trade durur.\n" +
               "%0 = sinirsiz.")

maxConsecLossInput = input.int(5, "Max Ardil Kayip", minval = 0, maxval = 20, group = GRP_PRO,
     tooltip = "Arka arkaya bu kadar kaybedilen trade'den sonra\n" +
               "strateji otomatik durur. Kazanilan trade sifirlar.\n" +
               "0 = sinirsiz.")

// ── Dashboard ──
showDashInput = input.bool(true, "Gosterge Paneli", group = GRP_DASH)
dashPosStr = input.string("Top Right", "Panel Konumu",
     options = ["Top Left", "Top Right", "Bottom Left", "Bottom Right", "Middle Right"], group = GRP_DASH)
dashFontSizeInput = input.string("Small", "Panel Yazi Boyutu",
     options = ["Small", "Normal", "Large", "Huge"], group = GRP_DASH)
showMarketSecInput = input.bool(true, "  - Piyasa", group = GRP_DASH)
showProfileSecInput = input.bool(true, "  - Profil", group = GRP_DASH)
showTradeSecInput = input.bool(true, "  - Islem", group = GRP_DASH)
showStatsSecInput = input.bool(true, "  - Istatistik", group = GRP_DASH)
showProSecInput = input.bool(true, "  - Profesyonel", group = GRP_DASH)

// ── Alerts ──
webhookInput = input.bool(false, "Webhook JSON", group = GRP_ALERT)
flipAlertInput = input.bool(true, "Trend Donus Uyarisi", group = GRP_ALERT)
showReverseAlertInput = input.bool(true, "Reverse Uyarisi", group = GRP_ALERT)
alertTpHitInput = input.bool(false, "TP/Basabas Uyarisi", group = GRP_ALERT)
lvnAlertInput = input.bool(false, "LVN Kirilim Uyarisi", group = GRP_ALERT)

// ── Colors ──
bullColorInput = input.color(#00E676, "Yukselis", inline = "colors", group = GRP_COLORS)
bearColorInput = input.color(#FF5252, "Dusus", inline = "colors", group = GRP_COLORS)

// ── Advanced ──
hvnThreshInput = input.float(0.55, "HVN Esigi (xPOC)", minval = 0.2, maxval = 0.95, step = 0.05, group = GRP_ADV)
lvnThreshInput = input.float(0.30, "LVN Esigi (xPOC)", minval = 0.05, maxval = 0.6, step = 0.05, group = GRP_ADV)

// ══════════════════════════════════════════════════════════
// 4. THEME
// ══════════════════════════════════════════════════════════
isDark = switch themeInput
    "Dark"  => true
    "Light" => false
    =>         true

TEXT_COLOR   = isDark ? #E0E0E0 : #1A1A1A
TEXT_MUTED   = isDark ? color.new(#9E9E9E, 0) : color.new(#757575, 0)
BULL_TEXT    = isDark ? #00E676 : #00A152
BEAR_TEXT    = isDark ? #FF5252 : #D32F2F
NEUTRAL_TEXT = isDark ? #FFEB3B : #F57F17
BULL_LABEL_TEXT = #004D25
BEAR_LABEL_TEXT = #FFFFFF
TABLE_BG       = isDark ? color.new(#131722, 5) : color.new(#FFFFFF, 5)
TABLE_ROW_ALT  = isDark ? color.new(#1C2030, 0) : color.new(#F0F4F8, 0)
TABLE_BORDER   = isDark ? color.new(#2A2E39, 0) : color.new(#D0D0D0, 0)
HEADER_TEXT    = #FFFFFF
HEADER_BG_BULL = color.new(#0F6E56, 0)
HEADER_BG_BEAR = color.new(#A32D2D, 0)
POC_COLOR     = isDark ? #FFD54F : #E65100
VA_COLOR      = isDark ? color.new(#90A4AE, 60) : color.new(#607D8B, 60)
LVN_COLOR     = isDark ? color.new(#B0BEC5, 30) : color.new(#546E7A, 30)
LVN_TEXT      = isDark ? #B0BEC5                 : #546E7A
SL_COLOR       = isDark ? color.new(#E57373, 0)  : color.new(#B71C1C, 0)
TP1_COLOR      = isDark ? color.new(#66BB6A, 30) : color.new(#388E3C, 30)
TP2_COLOR      = isDark ? color.new(#66BB6A, 40) : color.new(#388E3C, 40)
TP3_COLOR      = isDark ? color.new(#66BB6A, 0)  : color.new(#388E3C, 0)
ENTRY_COLOR    = isDark ? color.new(#5C8AAE, 0)  : color.new(#34495E, 0)
TP_LABEL_COLOR = isDark ? color.new(#66BB6A, 0)  : color.new(#388E3C, 0)
TP_HIT_COLOR   = isDark ? color.new(#4DB6AC, 0)  : color.new(#00695C, 0)
LABEL_TEXT     = isDark ? #1A1A1A                : #FFFFFF
FORM_COLOR     = isDark ? #5C8AAE                : #34495E
WM_COLOR = isDark ? color.new(#FFFFFF, 80) : color.new(#000000, 80)

// ══════════════════════════════════════════════════════════
// 5. FUNCTIONS
// ══════════════════════════════════════════════════════════
buildGauge(float value, float maxVal, int width) =>
    result = ""
    filled = maxVal <= 0 ? 0 : math.round(math.min(width, math.max(0.0, value / maxVal * width)))
    for i = 0 to width - 1
        result := result + (i < filled ? "|" : ".")
    result

fmtPrice(float v) =>
    na(v) ? "-" : str.tostring(v, format.mintick)

formatPctFromEntry(float level, float entry) =>
    res = ""
    if showPctOnLabelsInput and not na(level) and not na(entry) and entry != 0
        pct_ = (level - entry) / entry * 100.0
        sign_ = pct_ >= 0 ? "+" : ""
        res := " (" + sign_ + str.tostring(pct_, "#.##") + "%)"
    res

lineStyleFromString(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

sizeFromString(string s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Normal" ? size.normal : s == "Large" ? size.large : s == "Huge" ? size.huge : size.small

sizeDownFromString(string s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.tiny : s == "Normal" ? size.small : s == "Large" ? size.normal : s == "Huge" ? size.large : size.tiny

entryLineStyle  = lineStyleFromString(entryLineStyleInput)
tpLineStyle     = lineStyleFromString(tpLineStyleInput)
labelSize       = sizeFromString(labelFontSizeInput)
signalSize      = sizeFromString(signalFontSizeInput)
profLabelSize   = sizeFromString(profLabelSizeInput)
dashFontSize    = sizeFromString(dashFontSizeInput)
dashFontSizeSub = sizeDownFromString(dashFontSizeInput)

// ── Session filter ──
isSessionAllowed() =>
    if sessionFilterInput == "7/24"
        true
    else
        t_ = hour(time) * 100 + minute(time)
        sessionFilterInput == "London Only" ? t_ >= 700 and t_ < 1600 :
         sessionFilterInput == "NY Only" ? t_ >= 1300 and t_ < 2200 :
         sessionFilterInput == "London+NY" ? t_ >= 700 and t_ < 2200 :
         sessionFilterInput == "Asian Only" ? t_ >= 0 and t_ < 900 :
         false


// ══════════════════════════════════════════════════════════
// 6. CALCULATIONS — TREND ENGINE
// ══════════════════════════════════════════════════════════

[effBase, effStep] = switch bandPresetInput
    "Scalping"   => [2.5, 0.20]
    "Deep Trend" => [6.0, 0.30]
    "Custom"     => [baseMultInput, bandStepInput]
    =>              [4.0, 0.25]

float m1 = effBase
float m2 = effBase * (1.0 + effStep)
float m3 = effBase * (1.0 + 2.0 * effStep)
float m4 = effBase * (1.0 + 3.0 * effStep)

int flipChoice = flipBandStr == "Fast (Band 2)" ? 2 : flipBandStr == "Deep (Band 4)" ? 4 : 3

float trailAtr = nz(ta.atr(atrLenInput), 0.0)
float src      = srcInput

int WARMUP_BARS = math.max(atrLenInput * 3, 60)
bool isWarmedUp = bar_index >= WARMUP_BARS

float upper1 = src - trailAtr * m1
float upper2 = src - trailAtr * m2
float upper3 = src - trailAtr * m3
float upper4 = src - trailAtr * m4

float lower1 = src + trailAtr * m1
float lower2 = src + trailAtr * m2
float lower3 = src + trailAtr * m3
float lower4 = src + trailAtr * m4

var float ts1 = na
var float ts2 = na
var float ts3 = na
var float ts4 = na
var int   trend = 1
var int   trendStartBar = 0
var float trendHigh = na
var float trendLow  = na

float flipPrev = flipChoice == 2 ? ts2[1] : flipChoice == 3 ? ts3[1] : ts4[1]

bool doFlipDown = trend == 1  and not na(flipPrev) and src < flipPrev
bool doFlipUp   = trend == -1 and not na(flipPrev) and src > flipPrev

if trend == 1
    if doFlipDown
        trend := -1
        ts1 := lower1
        ts2 := lower2
        ts3 := lower3
        ts4 := lower4
    else
        ts1 := math.max(upper1, nz(ts1[1], upper1))
        ts2 := math.max(upper2, nz(ts2[1], upper2))
        ts3 := math.max(upper3, nz(ts3[1], upper3))
        ts4 := math.max(upper4, nz(ts4[1], upper4))
else
    if doFlipUp
        trend := 1
        ts1 := upper1
        ts2 := upper2
        ts3 := upper3
        ts4 := upper4
    else
        ts1 := math.min(lower1, nz(ts1[1], lower1))
        ts2 := math.min(lower2, nz(ts2[1], lower2))
        ts3 := math.min(lower3, nz(ts3[1], lower3))
        ts4 := math.min(lower4, nz(ts4[1], lower4))

int  trendPrev = nz(trend[1], 1)
bool flipBar   = trend != trendPrev

if flipBar
    trendStartBar := bar_index
    trendHigh := high
    trendLow  := low
else
    trendHigh := math.max(nz(trendHigh, high), high)
    trendLow  := math.min(nz(trendLow, low), low)

int barsInTrend = bar_index - trendStartBar

// ══════════════════════════════════════════════════════════
// 6B. HTF BIAS & VOLUME
// ══════════════════════════════════════════════════════════
[htfC, htfE] = request.security(syminfo.tickerid, htfInput, [close[1], ta.ema(close, 50)[1]], barmerge.gaps_off, barmerge.lookahead_on)

int biasDir = na(htfC) or na(htfE) ? 0 : htfC > htfE ? 1 : -1

float volRaw       = nz(volume, 0.0)
float volSma       = nz(ta.sma(nz(volume, 0.0), 20), 0.0)
float volBase      = nz(volSma[1], volSma)
float cumVol       = ta.cum(nz(volume, 0.0))
bool  symbolHasVol = cumVol > 0

// ══════════════════════════════════════════════════════════
// 7. SIGNAL LOGIC
// ══════════════════════════════════════════════════════════

bool confirmedBullFlip = flipBar and trend == 1  and barstate.isconfirmed and isWarmedUp
bool confirmedBearFlip = flipBar and trend == -1 and barstate.isconfirmed and isWarmedUp

var int pendingLong       = 0
var int pendingLongDepth  = 0
var int pendingShort      = 0
var int pendingShortDepth = 0
var int lastSigBar        = -10000

pendingLong  := math.max(pendingLong - 1, 0)
pendingShort := math.max(pendingShort - 1, 0)
if pendingLong == 0
    pendingLongDepth := 0
if pendingShort == 0
    pendingShortDepth := 0

if flipBar
    pendingLong       := 0
    pendingLongDepth  := 0
    pendingShort      := 0
    pendingShortDepth := 0

int touchDepthL = trend == 1  and not na(ts1) ? (low <= ts4 ? 4 : low <= ts3 ? 3 : low <= ts2 ? 2 : low <= ts1 ? 1 : 0) : 0
int touchDepthS = trend == -1 and not na(ts1) ? (high >= ts4 ? 4 : high >= ts3 ? 3 : high >= ts2 ? 2 : high >= ts1 ? 1 : 0) : 0

if touchDepthL > 0
    pendingLong      := retestWindowInput
    pendingLongDepth := math.max(pendingLongDepth, touchDepthL)

if touchDepthS > 0
    pendingShort      := retestWindowInput
    pendingShortDepth := math.max(pendingShortDepth, touchDepthS)

bool longReclaim  = pendingLong > 0  and trend == 1  and not na(ts1) and close > ts1 and close > open
bool shortReclaim = pendingShort > 0 and trend == -1 and not na(ts1) and close < ts1 and close < open

float rngBar = high - low
float clrL   = rngBar > 0 ? (close - low) / rngBar : 0.5
float clrS   = rngBar > 0 ? (high - close) / rngBar : 0.5

int depthPtsL  = pendingLongDepth == 2 ? 25 : pendingLongDepth == 3 ? 18 : pendingLongDepth == 1 ? 15 : pendingLongDepth == 4 ? 10 : 0
int depthPtsS  = pendingShortDepth == 2 ? 25 : pendingShortDepth == 3 ? 18 : pendingShortDepth == 1 ? 15 : pendingShortDepth == 4 ? 10 : 0
int candlePtsL = clrL > 0.7 ? 20 : clrL > 0.5 ? 12 : 5
int candlePtsS = clrS > 0.7 ? 20 : clrS > 0.5 ? 12 : 5
int agePts     = barsInTrend >= 10 and barsInTrend <= 150 ? 15 : barsInTrend < 10 ? 8 : 5
int volPts     = symbolHasVol ? (volRaw > volBase * 1.2 ? 20 : volRaw > volBase ? 12 : 5) : 12
int biasPtsL   = biasDir == 1 ? 20 : biasDir == 0 ? 10 : 0
int biasPtsS   = biasDir == -1 ? 20 : biasDir == 0 ? 10 : 0

int longScoreCalc  = depthPtsL + candlePtsL + agePts + volPts + biasPtsL
int shortScoreCalc = depthPtsS + candlePtsS + agePts + volPts + biasPtsS

bool cooldownOk = bar_index - lastSigBar >= cooldownInput

bool confirmedLongRetest  = longReclaim  and barstate.isconfirmed and isWarmedUp and cooldownOk and longScoreCalc >= minScoreInput
bool confirmedShortRetest = shortReclaim and barstate.isconfirmed and isWarmedUp and cooldownOk and shortScoreCalc >= minScoreInput

var string lastSignalStr   = "-"
var int    lastSignalBar   = na
var int    lastScore       = 0
var int    lastSignalDepth = 0

if confirmedLongRetest
    lastSignalStr    := "Long Retest"
    lastSignalBar    := bar_index
    lastScore        := longScoreCalc
    lastSignalDepth  := pendingLongDepth
    lastSigBar       := bar_index
    pendingLong      := 0
    pendingLongDepth := 0

if confirmedShortRetest
    lastSignalStr     := "Short Retest"
    lastSignalBar     := bar_index
    lastScore         := shortScoreCalc
    lastSignalDepth   := pendingShortDepth
    lastSigBar        := bar_index
    pendingShort      := 0
    pendingShortDepth := 0

if confirmedBullFlip
    lastSignalStr := "Bull Flip"
    lastSignalBar := bar_index
    lastScore     := 0

if confirmedBearFlip
    lastSignalStr := "Bear Flip"
    lastSignalBar := bar_index
    lastScore     := 0

// ══════════════════════════════════════════════════════════
// 8. RISK MANAGEMENT — PROFESSIONAL EDITION
// ══════════════════════════════════════════════════════════

[effTpBaseMult, effTP1m, effTP2m, effTP3m] = switch riskPresetInput
    "Conservative" => [2.5, 1.0, 2.0, 4.0]
    "Aggressive"   => [1.0, 1.5, 2.5, 4.0]
    "Scalping"     => [0.8, 0.8, 1.5, 2.0]
    "Custom"       => [tpBaseMultInput, tp1MultInput, tp2MultInput, tp3MultInput]
    =>                [1.5, 1.0, 2.0, 3.0]

float riskAtr    = nz(ta.atr(atrLenRiskInput), 0.0)
float tpDistance = riskAtr * effTpBaseMult

calcPositionQty(float entryPrice, int mgLevel) =>
    riskCapital_ = strategy.equity * riskPerTradeInput / 100.0
    slPts_ = riskAtr * effTpBaseMult
    pv_ = nz(syminfo.pointvalue, 1)
    riskPerContract_ = slPts_ * pv_
    riskQty_ = riskPerContract_ > 0 ? math.floor(riskCapital_ / riskPerContract_) : 999999
    marginQty_ = math.floor(strategy.equity / (entryPrice * pv_))
    baseQty_ = math.max(math.min(riskQty_, math.max(marginQty_, 1)), 1)
    int(math.max(baseQty_ * math.pow(2, mgLevel - 1), 1))

// ── Professional trackers ──
var int   consecLosses = 0
var float dayStartEquity = na
var int   dayStartBar = na
var bool  tradingPaused = false
var int   pauseBar = na

// Reset daily tracker on new day
int currentDay = dayofmonth(time)
if na(dayStartBar) or currentDay != dayofmonth(time[1])
    dayStartEquity := strategy.equity
    dayStartBar := bar_index
    // Daily pause expires at day change
    if tradingPaused
        tradingPaused := false
        pauseBar := na

// Max consecutive losses check
bool consecLossHalted = maxConsecLossInput > 0 and consecLosses >= maxConsecLossInput

// Max daily loss check
float dayDrawdownPct = not na(dayStartEquity) and dayStartEquity > 0 ? (dayStartEquity - strategy.equity) / dayStartEquity * 100.0 : 0.0
bool dailyLossHalted = maxDailyLossInput > 0 and dayDrawdownPct >= maxDailyLossInput

// Overall halt: paused flag or protection triggered
bool tradingHalted = tradingPaused or consecLossHalted or dailyLossHalted

// ── Position state ──
var float activeEntry = na
var float activeTP1   = na
var float activeTP2   = na
var float activeTP3   = na
var int   activeDir   = 0
var int   entryBarIdx = na
var bool  tp1Reached  = false
var bool  tp2Reached  = false
var bool  tp3Reached  = false

// Scaling state
var bool  tp1Scaled   = false
var bool  tp2Scaled   = false

// ── Session stats ──
var int    winCount  = 0
var int    lossCount = 0
var string formStr   = ""
var int    martingaleLevel    = 1
var float  martingaleBaseEntry = na
var int    entryBaseQty        = 0

// ── Bar-start captures ──

// ── Hit detection ──
bool canCheckHit = activeDir != 0 and not na(entryBarIdx) and bar_index > entryBarIdx and barstate.isconfirmed

bool tp1HitRaw = canCheckHit and (activeDir == 1 ? high >= activeTP1 : low  <= activeTP1)
bool tp2HitRaw = canCheckHit and (activeDir == 1 ? high >= activeTP2 : low  <= activeTP2)
bool tp3HitRaw = canCheckHit and (activeDir == 1 ? high >= activeTP3 : low  <= activeTP3)

bool tp1FirstTouch = tp1HitRaw and not tp1Reached
if tp1FirstTouch
    tp1Reached := true
    tp1Scaled := true

bool tp2FirstTouch = tp2HitRaw and not tp2Reached
if tp2FirstTouch
    tp2Reached := true
    tp2Scaled := true

bool tp3FirstTouch = tp3HitRaw and not tp3Reached
if tp3FirstTouch
    tp3Reached := true

// ── Snapshots ──
float exitEntry         = activeEntry
int   exitDir           = activeDir
float exitTP1           = activeTP1
float exitTP2           = activeTP2
float exitTP3           = activeTP3
bool  displayTp1Reached = tp1Reached
bool  displayTp2Reached = tp2Reached
bool  displayTp3Reached = tp3Reached

// ── Close on TP3 ──
if tp3Reached and activeDir != 0
    if activeDir == 1
        strategy.close("L")
        strategy.close("L_M2")
        strategy.close("L_M3")
        strategy.close("L_M4")
        strategy.close("L_M5")
    if activeDir == -1
        strategy.close("S")
        strategy.close("S_M2")
        strategy.close("S_M3")
        strategy.close("S_M4")
        strategy.close("S_M5")

if tp3Reached and activeDir != 0
    if tp1Reached
        winCount += 1
        consecLosses := 0
    else
        lossCount += 1
        consecLosses := consecLosses + 1
        if maxConsecLossInput > 0 and consecLosses >= maxConsecLossInput
            tradingPaused := true
            pauseBar := bar_index
    formStr := formStr + (tp1Reached ? "|" : ".")
    if str.length(formStr) > FORM_LEN
        formStr := str.substring(formStr, str.length(formStr) - FORM_LEN)
    activeDir     := 0
    activeEntry   := na
    activeTP1     := na
    activeTP2     := na
    activeTP3     := na
    entryBarIdx   := na
    tp1Reached    := false
    tp2Reached    := false
    tp3Reached    := false
    tp1Scaled     := false
    tp2Scaled     := false
    martingaleLevel    := 1
    martingaleBaseEntry := na
    entryBaseQty       := 0

// ── Signal direction ──
bool rawLongSignal  = confirmedLongRetest  or confirmedBullFlip
bool rawShortSignal = confirmedShortRetest or confirmedBearFlip

bool longEntrySignal  = reverseSignalInput ? rawShortSignal : rawLongSignal
bool shortEntrySignal = reverseSignalInput ? rawLongSignal : rawShortSignal

int sigDir = longEntrySignal ? 1 : shortEntrySignal ? -1 : 0

// ── Session + protection gates (only for NEW entries / reversals) ──
bool sessionOk = isSessionAllowed()
bool entryAllowed = barstate.isconfirmed and isWarmedUp and sessionOk and not tradingHalted

bool reverseToShort = sigDir == -1 and activeDir == 1
bool reverseToLong  = sigDir == 1  and activeDir == -1

bool evReversal = false
if (reverseToShort or reverseToLong) and entryAllowed
    evReversal := true
    if tp1Reached
        winCount += 1
        consecLosses := 0
    else
        lossCount += 1
        consecLosses := consecLosses + 1
        if maxConsecLossInput > 0 and consecLosses >= maxConsecLossInput
            tradingPaused := true
            pauseBar := bar_index
    formStr := formStr + (tp1Reached ? "|" : ".")
    if str.length(formStr) > FORM_LEN
        formStr := str.substring(formStr, str.length(formStr) - FORM_LEN)
    if activeDir == 1
    if activeDir == 1
        strategy.close("L")
        strategy.close("L_M2")
        strategy.close("L_M3")
        strategy.close("L_M4")
        strategy.close("L_M5")
    if activeDir == -1
        strategy.close("S")
        strategy.close("S_M2")
        strategy.close("S_M3")
        strategy.close("S_M4")
        strategy.close("S_M5")
    activeDir     := 0
    activeEntry   := na
    activeTP1     := na
    activeTP2     := na
    activeTP3     := na
    entryBarIdx   := na
    tp1Reached    := false
    tp2Reached    := false
    tp3Reached    := false
    tp1Scaled     := false
    tp2Scaled     := false
    martingaleLevel    := 1
    martingaleBaseEntry := na
    entryBaseQty       := 0

// ── Entries ──
bool evLongEntry  = false
bool evShortEntry = false

if longEntrySignal and activeDir == 0 and entryAllowed
    activeEntry := close
    activeTP1   := close + tpDistance * effTP1m
    activeTP2   := close + tpDistance * effTP2m
    activeTP3   := close + tpDistance * effTP3m
    activeDir   := 1
    entryBarIdx := bar_index
    tp1Reached  := false
    tp2Reached  := false
    tp3Reached  := false
    tp1Scaled   := false
    tp2Scaled   := false
    evLongEntry := true
    strategy.entry("L", strategy.long, qty = calcPositionQty(close, martingaleLevel), alert_message = "Uzun: " + str.tostring(close, format.mintick))
    martingaleLevel := 1
    martingaleBaseEntry := close
    entryBaseQty := calcPositionQty(close, martingaleLevel)

if shortEntrySignal and activeDir == 0 and entryAllowed
    activeEntry  := close
    activeTP1    := close - tpDistance * effTP1m
    activeTP2    := close - tpDistance * effTP2m
    activeTP3    := close - tpDistance * effTP3m
    activeDir    := -1
    entryBarIdx  := bar_index
    tp1Reached   := false
    tp2Reached   := false
    tp3Reached   := false
    tp1Scaled    := false
    tp2Scaled    := false
    evShortEntry := true
    strategy.entry("S", strategy.short, qty = calcPositionQty(close, martingaleLevel), alert_message = "Kisa: " + str.tostring(close, format.mintick))
    martingaleLevel := 1
    martingaleBaseEntry := close
    entryBaseQty := calcPositionQty(close, martingaleLevel)

// ── Martingale averaging (scale-in by ATR-spaced levels) ──
if activeDir != 0 and not na(martingaleBaseEntry) and barstate.isconfirmed and not tp3Reached
    float spacing_ = riskAtr * 0.5
    float trig_ = na
    int add_ = 0
    if activeDir == 1
        for lvl = 2 to 5
            if lvl > martingaleLevel
                trig_ := martingaleBaseEntry - (lvl - 1) * spacing_
                if low <= trig_
                    martingaleLevel := lvl
                    add_ := int(entryBaseQty * math.pow(2, lvl - 1))
                    strategy.entry("L_M" + str.tostring(lvl), strategy.long, qty = add_)
    if activeDir == -1
        for lvl = 2 to 5
            if lvl > martingaleLevel
                trig_ := martingaleBaseEntry + (lvl - 1) * spacing_
                if high >= trig_
                    martingaleLevel := lvl
                    add_ := int(entryBaseQty * math.pow(2, lvl - 1))
                    strategy.entry("S_M" + str.tostring(lvl), strategy.short, qty = add_)

// ── Dashboard risk metrics ──
float currentRR = activeDir != 0 ? effTP1m : 0.0
float riskPct   = activeDir != 0 and not na(activeEntry) and activeEntry != 0 ? tpDistance / activeEntry * 100 : 0.0

// ══════════════════════════════════════════════════════════
// 9. PLOTS & VISUALS
// ══════════════════════════════════════════════════════════
color trendColor = trend == 1 ? bullColorInput : bearColorInput

int B1_T = isDark ? 70 : 55
int B2_T = isDark ? 50 : 38
int B3_T = isDark ? 25 : 15
int H1_T = isDark ? 92 : 88
int H2_T = isDark ? 82 : 77
int H3_T = isDark ? 70 : 64

p1 = plot(flipBar ? na : ts1, "Band 1", color = color.new(trendColor, B1_T), linewidth = 1, style = plot.style_linebr, display = showBandsInput ? display.all : display.none)
p2 = plot(flipBar ? na : ts2, "Band 2", color = color.new(trendColor, B2_T), linewidth = 1, style = plot.style_linebr, display = showBandsInput ? display.all : display.none)
p3 = plot(flipBar ? na : ts3, "Band 3", color = color.new(trendColor, B3_T), linewidth = 2, style = plot.style_linebr, display = showBandsInput ? display.all : display.none)
p4 = plot(flipBar ? na : ts4, "Band 4", color = color.new(trendColor, 0),   linewidth = 2, style = plot.style_linebr, display = showBandsInput ? display.all : display.none)

fill(p1, p2, color.new(trendColor, H1_T), title = "Heatmap Inner",  display = showHeatInput ? display.all : display.none)
fill(p2, p3, color.new(trendColor, H2_T), title = "Heatmap Middle", display = showHeatInput ? display.all : display.none)
fill(p3, p4, color.new(trendColor, H3_T), title = "Heatmap Outer",  display = showHeatInput ? display.all : display.none)

// ══════════════════════════════════════════════════════════
// 10. LABELS & SHAPES
// ══════════════════════════════════════════════════════════
if confirmedBullFlip and showFlipLabelsInput
    label.new(bar_index, ts4, "^ DONUS",
         color     = bullColorInput,
         textcolor = BULL_LABEL_TEXT,
         style     = label.style_label_up,
         size      = signalSize,
          tooltip   = "Yukselis Donusu")

if confirmedBearFlip and showFlipLabelsInput
    label.new(bar_index, ts4, "v DONUS",
         color     = bearColorInput,
         textcolor = BEAR_LABEL_TEXT,
         style     = label.style_label_down,
         size      = signalSize,
          tooltip   = "Dusus Donusu")

if confirmedLongRetest and showSignalsInput
    string ttL = "Uzun Test | Skor " + str.tostring(longScoreCalc) + "/100"
    label.new(bar_index, low, "+ " + str.tostring(longScoreCalc),
         color     = bullColorInput,
         textcolor = BULL_LABEL_TEXT,
         style     = label.style_label_up,
         size      = signalSize,
         tooltip   = ttL)

if confirmedShortRetest and showSignalsInput
    string ttS = "Kisa Test | Skor " + str.tostring(shortScoreCalc) + "/100"
    label.new(bar_index, high, "+ " + str.tostring(shortScoreCalc),
         color     = bearColorInput,
         textcolor = BEAR_LABEL_TEXT,
         style     = label.style_label_down,
         size      = signalSize,
         tooltip   = ttS)

if showSignalsInput and evLongEntry and not confirmedLongRetest
    label.new(bar_index, low, "Uzun ^",
         color     = bullColorInput,
         textcolor = BULL_LABEL_TEXT,
         style     = label.style_label_up,
         size      = signalSize,
         tooltip   = "Uzun giris (donus)")

if showSignalsInput and evShortEntry and not confirmedShortRetest
    label.new(bar_index, high, "Kisa v",
         color     = bearColorInput,
         textcolor = BEAR_LABEL_TEXT,
         style     = label.style_label_down,
         size      = signalSize,
         tooltip   = "Kisa giris (donus)")

// ── Trend P&L ──
var float trendStartPrice = na
var line  trendPnlLine    = na
var label trendPnlLabel   = na

if flipBar
    trendStartPrice := close

if showTrendPnlInput and flipBar
    line.delete(trendPnlLine)
    label.delete(trendPnlLabel)
    trendPnlLine  := line.new(bar_index, close, bar_index + 1, close, color = color.new(trendColor, 60), style = line.style_dotted, width = 1)
    trendPnlLabel := label.new(bar_index + 2, close, "", color = TP_LABEL_COLOR, textcolor = LABEL_TEXT, style = label.style_label_left, size = signalSize)

if showTrendPnlInput and not na(trendPnlLabel) and not na(trendStartPrice) and trendStartPrice != 0
    float trendPnlPct = (close - trendStartPrice) / trendStartPrice * 100.0 * trend
    string tpnlSign = trendPnlPct >= 0 ? "+" : ""
    line.set_x2(trendPnlLine, bar_index)
    label.set_xy(trendPnlLabel, bar_index + 2, close)
    label.set_text(trendPnlLabel, (trend == 1 ? "^ " : "v ") + tpnlSign + str.tostring(trendPnlPct, "#.##") + "%")
    label.set_color(trendPnlLabel, trendPnlPct >= 0 ? TP_LABEL_COLOR : SL_COLOR)

// ══════════════════════════════════════════════════════════
// 11. SL/TP LINES
// ══════════════════════════════════════════════════════════
var line tp1Line   = na
var line tp2Line   = na
var line tp3Line   = na
var line entryLine = na

var label tp1Label   = na
var label tp2Label   = na
var label tp3Label   = na
var label entryLabel = na

if (evLongEntry or evShortEntry) and showTpInput
    line.delete(tp1Line)
    line.delete(tp2Line)
    line.delete(tp3Line)
    line.delete(entryLine)
    label.delete(tp1Label)
    label.delete(tp2Label)
    label.delete(tp3Label)
    label.delete(entryLabel)

    int x1 = bar_index
    int x2 = bar_index + LINE_FORWARD_BARS

    entryLine := line.new(x1, activeEntry, x2, activeEntry, color = ENTRY_COLOR, style = entryLineStyle, width = 1)
    tp1Line   := line.new(x1, activeTP1,   x2, activeTP1,   color = TP1_COLOR,   style = tpLineStyle,    width = 1)
    tp2Line   := line.new(x1, activeTP2,   x2, activeTP2,   color = TP2_COLOR,   style = tpLineStyle,    width = 1)
    tp3Line   := line.new(x1, activeTP3,   x2, activeTP3,   color = TP3_COLOR,   style = tpLineStyle,    width = 1)

    if showTpLabelsInput
        int lblX = x2 + LABEL_OFFSET_BARS
        string entryS = str.tostring(activeEntry, format.mintick)
        string tp1S   = fmtPrice(activeTP1) + formatPctFromEntry(activeTP1, activeEntry)
        string tp2S   = fmtPrice(activeTP2) + formatPctFromEntry(activeTP2, activeEntry)
        string tp3S   = fmtPrice(activeTP3) + formatPctFromEntry(activeTP3, activeEntry)

        entryLabel := label.new(lblX, activeEntry, "GIRIS " + entryS, color = ENTRY_COLOR, textcolor = LABEL_TEXT, style = label.style_label_left, size = labelSize)
        tp1Label   := label.new(lblX, activeTP1, "TP1 " + tp1S, color = TP_LABEL_COLOR, textcolor = LABEL_TEXT, style = label.style_label_left, size = labelSize)
        tp2Label   := label.new(lblX, activeTP2, "TP2 " + tp2S, color = TP_LABEL_COLOR, textcolor = LABEL_TEXT, style = label.style_label_left, size = labelSize)
        tp3Label   := label.new(lblX, activeTP3, "TP3 " + tp3S, color = TP_LABEL_COLOR, textcolor = LABEL_TEXT, style = label.style_label_left, size = labelSize)

// ── TP-hit recolor ──
if showTpInput and not na(tp1Line) and displayTp1Reached and not (evLongEntry or evShortEntry)
    line.set_color(tp1Line, TP_HIT_COLOR)
    line.set_style(tp1Line, line.style_solid)
    if showTpLabelsInput and not na(tp1Label)
        label.set_text(tp1Label, "TP1 V " + fmtPrice(exitTP1) + formatPctFromEntry(exitTP1, exitEntry))
        label.set_color(tp1Label, TP_HIT_COLOR)
if showTpInput and not na(tp2Line) and displayTp2Reached and not (evLongEntry or evShortEntry)
    line.set_color(tp2Line, TP_HIT_COLOR)
    line.set_style(tp2Line, line.style_solid)
    if showTpLabelsInput and not na(tp2Label)
        label.set_text(tp2Label, "TP2 V " + fmtPrice(exitTP2) + formatPctFromEntry(exitTP2, exitEntry))
        label.set_color(tp2Label, TP_HIT_COLOR)
if showTpInput and not na(tp3Line) and displayTp3Reached and not (evLongEntry or evShortEntry)
    line.set_color(tp3Line, TP_HIT_COLOR)
    line.set_style(tp3Line, line.style_solid)
    if showTpLabelsInput and not na(tp3Label)
        label.set_text(tp3Label, "TP3 V " + fmtPrice(exitTP3) + formatPctFromEntry(exitTP3, exitEntry))
        label.set_color(tp3Label, TP_HIT_COLOR)

// ── Extend lines ──
if activeDir != 0 and not na(tp1Line)
    int newX2   = bar_index + LINE_UPDATE_BARS
    int newLblX = newX2 + LABEL_OFFSET_BARS
    line.set_x2(tp1Line,   newX2)
    line.set_x2(tp2Line,   newX2)
    line.set_x2(tp3Line,   newX2)
    line.set_x2(entryLine, newX2)
    if showTpLabelsInput
        label.set_x(tp1Label,   newLblX)
        label.set_x(tp2Label,   newLblX)
        label.set_x(tp3Label,   newLblX)
        label.set_x(entryLabel, newLblX)

// ══════════════════════════════════════════════════════════
// 12. VOLUME PROFILE
// ══════════════════════════════════════════════════════════
var box[]   pfBoxes  = array.new_box()
var line[]  pfLines  = array.new_line()
var label[] pfLabels = array.new_label()
var float[] lvnLevels = array.new_float()

var float pocPrice = na
var float vahPrice = na
var float valPrice = na

int profOffset = profWidthInput + 8

bool profNeeded = showProfileInput or showPocInput or showVaInput or showNodesInput or lvnAlertInput or showDashInput

if barstate.islast and profNeeded
    for b in pfBoxes
        box.delete(b)
    for l in pfLines
        line.delete(l)
    for lb in pfLabels
        label.delete(lb)
    array.clear(pfBoxes)
    array.clear(pfLines)
    array.clear(pfLabels)
    array.clear(lvnLevels)
    pocPrice := na
    vahPrice := na
    valPrice := na

    int segBars  = barsInTrend + 1
    int lookback = math.min(math.min(segBars, maxProfBarsInput), bar_index + 1)

    if lookback >= 3
        float wHi = high
        float wLo = low
        for i = 0 to lookback - 1
            wHi := math.max(wHi, high[i])
            wLo := math.min(wLo, low[i])

        float binSize = (wHi - wLo) / profRowsInput

        if binSize > 0
            float[] vols = array.new_float(profRowsInput, 0.0)

            for i = 0 to lookback - 1
                float bH = high[i]
                float bL = low[i]
                float w  = symbolHasVol ? nz(volume[i], 0.0) : math.max(bH - bL, syminfo.mintick)
                if w > 0
                    float rng = bH - bL
                    if rng <= 0
                        int cIdx = math.min(profRowsInput - 1, math.max(0, int(math.floor((close[i] - wLo) / binSize))))
                        array.set(vols, cIdx, array.get(vols, cIdx) + w)
                    else
                        int i0 = math.min(profRowsInput - 1, math.max(0, int(math.floor((bL - wLo) / binSize))))
                        int i1 = math.min(profRowsInput - 1, math.max(0, int(math.floor((bH - wLo) / binSize))))
                        for bn = i0 to i1
                            float bin0 = wLo + binSize * bn
                            float bin1 = bin0 + binSize
                            float ov   = math.max(0.0, math.min(bH, bin1) - math.max(bL, bin0))
                            if ov > 0
                                array.set(vols, bn, array.get(vols, bn) + w * ov / rng)

            float maxVol   = 0.0
            float totalVol = 0.0
            int   pocIdx   = 0
            for i = 0 to profRowsInput - 1
                float v = array.get(vols, i)
                totalVol += v
                if v > maxVol
                    maxVol := v
                    pocIdx := i

            if maxVol > 0 and totalVol > 0
                pocPrice := wLo + binSize * (pocIdx + 0.5)

                float vaTarget = totalVol * 0.70
                float vaAcc    = array.get(vols, pocIdx)
                int   upIdx    = pocIdx + 1
                int   dnIdx    = pocIdx - 1
                while vaAcc < vaTarget
                    float vu = upIdx <= profRowsInput - 1 ? array.get(vols, upIdx) : -1.0
                    float vd = dnIdx >= 0 ? array.get(vols, dnIdx) : -1.0
                    if vu < 0 and vd < 0
                        break
                    if vu >= vd
                        vaAcc += math.max(vu, 0.0)
                        upIdx += 1
                    else
                        vaAcc += math.max(vd, 0.0)
                        dnIdx -= 1
                int vahIdx = upIdx - 1
                int valIdx = dnIdx + 1
                vahPrice := wLo + binSize * (vahIdx + 1)
                valPrice := wLo + binSize * valIdx

                int segStartX = bar_index - lookback + 1

                if showVaInput
                    box vaBox = box.new(segStartX, vahPrice, bar_index + profOffset, valPrice,
                         border_color = color.new(color.gray, 100),
                         bgcolor      = color.new(color.gray, isDark ? 92 : 94))
                    array.push(pfBoxes, vaBox)
                    line vahLine = line.new(segStartX, vahPrice, bar_index + profOffset, vahPrice, color = VA_COLOR, style = line.style_dashed, width = 1)
                    line valLine = line.new(segStartX, valPrice, bar_index + profOffset, valPrice, color = VA_COLOR, style = line.style_dashed, width = 1)
                    array.push(pfLines, vahLine)
                    array.push(pfLines, valLine)

                for i = 0 to profRowsInput - 1
                    float v    = array.get(vols, i)
                    float bTop = wLo + binSize * (i + 1)
                    float bBot = wLo + binSize * i
                    float bMid = (bTop + bBot) / 2
                    int   bw   = int(math.round(v / maxVol * profWidthInput))

                    if showProfileInput and bw > 0
                        color binCol = color.from_gradient(v, 0, maxVol, color.new(trendColor, 85), color.new(trendColor, 20))
                        box hb = box.new(bar_index + profOffset - bw, bTop, bar_index + profOffset, bBot,
                             border_color = color.new(chart.bg_color, 30),
                             bgcolor      = binCol)
                        array.push(pfBoxes, hb)

                    bool isLocalMax = i > 0 and i < profRowsInput - 1 and v > array.get(vols, i - 1) and v > array.get(vols, i + 1)
                    bool isLocalMin = i > 0 and i < profRowsInput - 1 and v < array.get(vols, i - 1) and v < array.get(vols, i + 1)
                    bool insideVA   = bMid <= vahPrice and bMid >= valPrice

                    if showNodesInput and isLocalMax and v >= maxVol * hvnThreshInput and i != pocIdx
                        line hvnLn = line.new(segStartX, bMid, bar_index + profOffset - bw, bMid, color = color.new(trendColor, 35), style = line.style_dotted, width = 1)
                        array.push(pfLines, hvnLn)

                    if showNodesInput and isLocalMin and v <= maxVol * lvnThreshInput and insideVA
                        line lvnLn = line.new(segStartX, bMid, bar_index + profOffset - bw, bMid, color = LVN_COLOR, style = line.style_dotted, width = 1)
                        array.push(pfLines, lvnLn)
                        label lvnLb = label.new(bar_index + profOffset + 1, bMid, "LVN", color = color.new(color.black, 100), textcolor = LVN_TEXT, style = label.style_label_left, size = profLabelSize)
                        array.push(pfLabels, lvnLb)
                        array.push(lvnLevels, bMid)

                if showPocInput
                    line pocLn = line.new(segStartX, pocPrice, bar_index + profOffset, pocPrice, color = POC_COLOR, style = line.style_solid, width = 2)
                    array.push(pfLines, pocLn)
                    string pocVolStr = symbolHasVol ? str.tostring(maxVol, format.volume) : "menzil-ag"
                    label pocLb = label.new(bar_index + profOffset + 1, pocPrice, "POC " + str.tostring(pocPrice, format.mintick) + " . " + pocVolStr, color = color.new(color.black, 100), textcolor = POC_COLOR, style = label.style_label_left, size = profLabelSize)
                    array.push(pfLabels, pocLb)

// ── LVN break alert ──
bool  lvnCross    = false
float lvnCrossLvl = na
if lvnAlertInput and barstate.isconfirmed and array.size(lvnLevels) > 0
    for i = 0 to array.size(lvnLevels) - 1
        float lvl = array.get(lvnLevels, i)
        bool crossedUp   = close[1] < lvl and close >= lvl
        bool crossedDown = close[1] > lvl and close <= lvl
        if crossedUp or crossedDown
            lvnCross    := true
            lvnCrossLvl := lvl

// ══════════════════════════════════════════════════════════
// 13. DASHBOARD
// ══════════════════════════════════════════════════════════
dashPos = switch dashPosStr
    "Top Left"     => position.top_left
    "Top Right"    => position.top_right
    "Bottom Left"  => position.bottom_left
    "Bottom Right" => position.bottom_right
    "Middle Right" => position.middle_right
    =>                position.top_right

var table dashTable = na

if showDashInput and barstate.islast
    string trendWord = trend == 1 ? "Yukselis" : "Dusus"
    color  trendCol  = trend == 1 ? BULL_TEXT : BEAR_TEXT
    color  headerBg  = trend == 1 ? HEADER_BG_BULL : HEADER_BG_BEAR

    string biasStr = biasDir == 1 ? "Yukselis" : biasDir == -1 ? "Dusus" : "-"
    color  biasCol = biasDir == 1 ? BULL_TEXT : biasDir == -1 ? BEAR_TEXT : TEXT_MUTED

    string signalStr = activeDir == 1 ? "UZUN" : activeDir == -1 ? "KISA" : "Bekle"
    color  signalCol = activeDir == 1 ? BULL_TEXT : activeDir == -1 ? BEAR_TEXT : TEXT_MUTED

    string sigAgo       = na(lastSignalBar) ? "" : " (" + str.tostring(bar_index - lastSignalBar) + ")"
    string lastSigStr   = lastSignalStr == "-" ? "-" : lastSignalStr + (lastScore > 0 ? " . " + str.tostring(lastScore) : "") + sigAgo
    color  lastSigCol   = lastSignalStr == "Long Retest" or lastSignalStr == "Bull Flip" ? BULL_TEXT : lastSignalStr == "-" ? TEXT_MUTED : BEAR_TEXT

    string ageStr = str.tostring(barsInTrend) + " bar"

    string pocStr = na(pocPrice) ? "-" : str.tostring(pocPrice, format.mintick)
    string vahStr = na(vahPrice) ? "-" : str.tostring(vahPrice, format.mintick)
    string valStr = na(valPrice) ? "-" : str.tostring(valPrice, format.mintick)

    string dashEntry = activeDir != 0 and not na(activeEntry) ? str.tostring(activeEntry, format.mintick) : "-"
    string dashTP1   = activeDir != 0 and not na(activeTP1) ? (tp1Reached ? "V " : "") + str.tostring(activeTP1, format.mintick) : "-"
    string dashTP2   = activeDir != 0 and not na(activeTP2) ? (tp2Reached ? "V " : "") + str.tostring(activeTP2, format.mintick) : "-"
    string dashTP3   = activeDir != 0 and not na(activeTP3) ? (tp3Reached ? "V " : "") + str.tostring(activeTP3, format.mintick) : "-"
    color  dashTp1Col = tp1Reached ? TP_HIT_COLOR : TP_LABEL_COLOR
    color  dashTp2Col = tp2Reached ? TP_HIT_COLOR : TP_LABEL_COLOR
    color  dashTp3Col = tp3Reached ? TP_HIT_COLOR : TP_LABEL_COLOR

    string dashRR   = str.tostring(currentRR, "#.#") + "R"
    string dashDist = str.tostring(riskPct, "#.##") + "%"
    color  rrColor   = currentRR >= 1.5 ? BULL_TEXT : currentRR >= 1.0 ? NEUTRAL_TEXT : BEAR_TEXT
    color  distColor = riskPct > 3.0 ? BEAR_TEXT : riskPct > 1.0 ? NEUTRAL_TEXT : BULL_TEXT

    int    closedTrades = winCount + lossCount
    float  winRate      = closedTrades > 0 ? winCount / float(closedTrades) * 100.0 : 0.0
    string dashWL       = str.tostring(winCount) + " / " + str.tostring(lossCount)
    string dashWR       = closedTrades > 0 ? str.tostring(winRate, "#.#") + "%  " + buildGauge(winRate, 100, 8) : "-"
    color  wrCol        = closedTrades == 0 ? TEXT_MUTED : winRate >= 55.0 ? BULL_TEXT : winRate >= 45.0 ? NEUTRAL_TEXT : BEAR_TEXT
    string dashForm     = formStr == "" ? "-" : formStr

    // Pro stats
    string sessionLabel = sessionFilterInput
    string riskLabel    = str.tostring(riskPerTradeInput, "#.#") + "%"
    string consecStr    = str.tostring(consecLosses) + " / " + str.tostring(maxConsecLossInput > 0 ? maxConsecLossInput : 999)
    color  consecCol    = consecLosses == 0 ? BULL_TEXT : consecLosses >= maxConsecLossInput * 0.7 ? BEAR_TEXT : NEUTRAL_TEXT
    string dayLossStr   = str.tostring(dayDrawdownPct, "#.##") + "% / " + str.tostring(maxDailyLossInput > 0 ? maxDailyLossInput : 999, "#.#") + "%"
    color  dayLossCol   = dayDrawdownPct == 0 ? BULL_TEXT : dayDrawdownPct >= maxDailyLossInput * 0.7 ? BEAR_TEXT : NEUTRAL_TEXT
    string haltStr = tradingHalted ? "DURDURULDU" : "Aktif"
    color  haltCol = tradingHalted ? BEAR_TEXT : BULL_TEXT
    string scalingStr = tp1Scaled or tp2Scaled ? "TP1:" + str.tostring(tp1ScalePctInput, "#") + "% TP2:" + str.tostring(tp2ScalePctInput, "#") + "%" : "-"

    int marketRows  = showMarketSecInput  ? 6 : 0
    int profileRows = showProfileSecInput ? 4 : 0
    int tradeRows   = showTradeSecInput   ? (activeDir != 0 ? 7 : 2) : 0
    int statsRows   = showStatsSecInput   ? 5 : 0
    int proRows     = showProSecInput     ? 7 : 0
    int totalRows   = 2 + marketRows + profileRows + tradeRows + statsRows + proRows

    if not na(dashTable)
        table.delete(dashTable)
    dashTable := table.new(dashPos, 2, totalRows, bgcolor = TABLE_BG, border_color = TABLE_BORDER, border_width = 1, frame_color = TABLE_BORDER, frame_width = 1)

    int  r   = 0
    bool zeb = false
    color rb = TABLE_BG

    table.cell(dashTable, 0, r, "+ LTM . " + trendWord, text_color = HEADER_TEXT, bgcolor = headerBg, text_size = dashFontSize, text_halign = text.align_center)
    table.merge_cells(dashTable, 0, r, 1, r)
    r += 1

    if showMarketSecInput
        table.cell(dashTable, 0, r, "- Piyasa -", text_color = TEXT_MUTED, bgcolor = TABLE_ROW_ALT, text_size = dashFontSizeSub, text_halign = text.align_center)
        table.merge_cells(dashTable, 0, r, 1, r)
        r += 1
        rb := zeb ? TABLE_ROW_ALT : TABLE_BG
        table.cell(dashTable, 0, r, "Trend", text_color = TEXT_MUTED, text_size = dashFontSize, bgcolor = rb)
        table.cell(dashTable, 1, r, trendWord, text_color = trendCol, text_size = dashFontSize, bgcolor = rb)
        r += 1
        zeb := not zeb
        rb := zeb ? TABLE_ROW_ALT : TABLE_BG
        table.cell(dashTable, 0, r, "Yas", text_color = TEXT_MUTED, text_size = dashFontSize, bgcolor = rb)
        table.cell(dashTable, 1, r, ageStr, text_color = TEXT_COLOR, text_size = dashFontSize, bgcolor = rb)
        r += 1
        zeb := not zeb
        rb := zeb ? TABLE_ROW_ALT : TABLE_BG
        table.cell(dashTable, 0, r, "UST Yon", text_color = TEXT_MUTED, text_size = dashFontSize, bgcolor = rb)
        table.cell(dashTable, 1, r, biasStr, text_color = biasCol, text_size = dashFontSize, bgcolor = rb)
        r += 1
        zeb := not zeb
        rb := zeb ? TABLE_ROW_ALT : TABLE_BG
        table.cell(dashTable, 0, r, "Sinyal", text_color = TEXT_MUTED, text_size = dashFontSize, bgcolor = rb)
        table.cell(dashTable, 1, r, signalStr, text_color = signalCol, text_size = dashFontSize, bgcolor = rb)
        r += 1
        zeb := not zeb
        rb := zeb ? TABLE_ROW_ALT : TABLE_BG
        table.cell(dashTable, 0, r, "Son sinyal", text_color = TEXT_MUTED, text_size = dashFontSize, bgcolor = rb)
        table.cell(dashTable, 1, r, lastSigStr, text_color = lastSigCol, text_size = dashFontSize, bgcolor = rb)
        r += 1
        zeb := not zeb

    if showProfileSecInput
        table.cell(dashTable, 0, r, "- Profil -", text_color = TEXT_MUTED, bgcolor = TABLE_ROW_ALT, text_size = dashFontSizeSub, text_halign = text.align_center)
        table.merge_cells(dashTable, 0, r, 1, r)
        r += 1
        rb := zeb ? TABLE_ROW_ALT : TABLE_BG
        table.cell(dashTable, 0, r, "POC", text_color = TEXT_MUTED, text_size = dashFontSize, bgcolor = rb)
        table.cell(dashTable, 1, r, pocStr, text_color = POC_COLOR, text_size = dashFontSize, bgcolor = rb)
        r += 1
        zeb := not zeb
        rb := zeb ? TABLE_ROW_ALT : TABLE_BG
        table.cell(dashTable, 0, r, "VA Tepe", text_color = TEXT_MUTED, text_size = dashFontSize, bgcolor = rb)
        table.cell(dashTable, 1, r, vahStr, text_color = TEXT_COLOR, text_size = dashFontSize, bgcolor = rb)
        r += 1
        zeb := not zeb
        rb := zeb ? TABLE_ROW_ALT : TABLE_BG
        table.cell(dashTable, 0, r, "VA Taban", text_color = TEXT_MUTED, text_size = dashFontSize, bgcolor = rb)
        table.cell(dashTable, 1, r, valStr, text_color = TEXT_COLOR, text_size = dashFontSize, bgcolor = rb)
        r += 1
        zeb := not zeb

    if showTradeSecInput
        table.cell(dashTable, 0, r, "- Islem -", text_color = TEXT_MUTED, bgcolor = TABLE_ROW_ALT, text_size = dashFontSizeSub, text_halign = text.align_center)
        table.merge_cells(dashTable, 0, r, 1, r)
        r += 1
        if activeDir != 0
            rb := zeb ? TABLE_ROW_ALT : TABLE_BG
            table.cell(dashTable, 0, r, "Giris", text_color = TEXT_MUTED, text_size = dashFontSize, bgcolor = rb)
            table.cell(dashTable, 1, r, dashEntry, text_color = ENTRY_COLOR, text_size = dashFontSize, bgcolor = rb)
            r += 1
            zeb := not zeb
            rb := zeb ? TABLE_ROW_ALT : TABLE_BG
            table.cell(dashTable, 0, r, "TP1", text_color = TEXT_MUTED, text_size = dashFontSize, bgcolor = rb)
            table.cell(dashTable, 1, r, dashTP1, text_color = dashTp1Col, text_size = dashFontSize, bgcolor = rb)
            r += 1
            zeb := not zeb
            rb := zeb ? TABLE_ROW_ALT : TABLE_BG
            table.cell(dashTable, 0, r, "TP2", text_color = TEXT_MUTED, text_size = dashFontSize, bgcolor = rb)
            table.cell(dashTable, 1, r, dashTP2, text_color = dashTp2Col, text_size = dashFontSize, bgcolor = rb)
            r += 1
            zeb := not zeb
            rb := zeb ? TABLE_ROW_ALT : TABLE_BG
            table.cell(dashTable, 0, r, "TP3", text_color = TEXT_MUTED, text_size = dashFontSize, bgcolor = rb)
            table.cell(dashTable, 1, r, dashTP3, text_color = dashTp3Col, text_size = dashFontSize, bgcolor = rb)
            r += 1
            zeb := not zeb
            rb := zeb ? TABLE_ROW_ALT : TABLE_BG
            table.cell(dashTable, 0, r, "R:R (TP1)", text_color = TEXT_MUTED, text_size = dashFontSize, bgcolor = rb)
            table.cell(dashTable, 1, r, dashRR, text_color = rrColor, text_size = dashFontSize, bgcolor = rb)
            r += 1
            zeb := not zeb
            rb := zeb ? TABLE_ROW_ALT : TABLE_BG
            table.cell(dashTable, 0, r, "Risk %", text_color = TEXT_MUTED, text_size = dashFontSize, bgcolor = rb)
            table.cell(dashTable, 1, r, dashDist, text_color = distColor, text_size = dashFontSize, bgcolor = rb)
            r += 1
            zeb := not zeb
        else
            rb := zeb ? TABLE_ROW_ALT : TABLE_BG
            table.cell(dashTable, 0, r, "Flat", text_color = TEXT_MUTED, text_size = dashFontSize, text_halign = text.align_center, bgcolor = rb)
            table.merge_cells(dashTable, 0, r, 1, r)
            r += 1
            zeb := not zeb

    if showStatsSecInput
        table.cell(dashTable, 0, r, "- Istatistik -", text_color = TEXT_MUTED, bgcolor = TABLE_ROW_ALT, text_size = dashFontSizeSub, text_halign = text.align_center)
        table.merge_cells(dashTable, 0, r, 1, r)
        r += 1
        rb := zeb ? TABLE_ROW_ALT : TABLE_BG
        table.cell(dashTable, 0, r, "Islemler", text_color = TEXT_MUTED, text_size = dashFontSize, bgcolor = rb)
        table.cell(dashTable, 1, r, str.tostring(closedTrades), text_color = TEXT_COLOR, text_size = dashFontSize, bgcolor = rb)
        r += 1
        zeb := not zeb
        rb := zeb ? TABLE_ROW_ALT : TABLE_BG
        table.cell(dashTable, 0, r, "K / Z", text_color = TEXT_MUTED, text_size = dashFontSize, bgcolor = rb)
        table.cell(dashTable, 1, r, dashWL, text_color = TEXT_COLOR, text_size = dashFontSize, bgcolor = rb)
        r += 1
        zeb := not zeb
        rb := zeb ? TABLE_ROW_ALT : TABLE_BG
        table.cell(dashTable, 0, r, "Kazanma Orani", text_color = TEXT_MUTED, text_size = dashFontSize, bgcolor = rb)
        table.cell(dashTable, 1, r, dashWR, text_color = wrCol, text_size = dashFontSize, bgcolor = rb)
        r += 1
        zeb := not zeb
        rb := zeb ? TABLE_ROW_ALT : TABLE_BG
        table.cell(dashTable, 0, r, "Form", text_color = TEXT_MUTED, text_size = dashFontSize, bgcolor = rb)
        table.cell(dashTable, 1, r, dashForm, text_color = FORM_COLOR, text_size = dashFontSize, bgcolor = rb)
        r += 1
        zeb := not zeb

    // ── Professional section ──
    if showProSecInput
        table.cell(dashTable, 0, r, "- Profesyonel -", text_color = TEXT_MUTED, bgcolor = TABLE_ROW_ALT, text_size = dashFontSizeSub, text_halign = text.align_center)
        table.merge_cells(dashTable, 0, r, 1, r)
        r += 1
        rb := zeb ? TABLE_ROW_ALT : TABLE_BG
        table.cell(dashTable, 0, r, "Seans", text_color = TEXT_MUTED, text_size = dashFontSize, bgcolor = rb)
        table.cell(dashTable, 1, r, sessionLabel, text_color = TEXT_COLOR, text_size = dashFontSize, bgcolor = rb)
        r += 1
        zeb := not zeb
        rb := zeb ? TABLE_ROW_ALT : TABLE_BG
        table.cell(dashTable, 0, r, "Risk/Trade", text_color = TEXT_MUTED, text_size = dashFontSize, bgcolor = rb)
        table.cell(dashTable, 1, r, riskLabel, text_color = TEXT_COLOR, text_size = dashFontSize, bgcolor = rb)
        r += 1
        zeb := not zeb
        rb := zeb ? TABLE_ROW_ALT : TABLE_BG
        table.cell(dashTable, 0, r, "Ardil Kayip", text_color = TEXT_MUTED, text_size = dashFontSize, bgcolor = rb)
        table.cell(dashTable, 1, r, consecStr, text_color = consecCol, text_size = dashFontSize, bgcolor = rb)
        r += 1
        zeb := not zeb
        rb := zeb ? TABLE_ROW_ALT : TABLE_BG
        table.cell(dashTable, 0, r, "Gunluk Kayip", text_color = TEXT_MUTED, text_size = dashFontSize, bgcolor = rb)
        table.cell(dashTable, 1, r, dayLossStr, text_color = dayLossCol, text_size = dashFontSize, bgcolor = rb)
        r += 1
        zeb := not zeb
        rb := zeb ? TABLE_ROW_ALT : TABLE_BG
        table.cell(dashTable, 0, r, "Durum", text_color = TEXT_MUTED, text_size = dashFontSize, bgcolor = rb)
        table.cell(dashTable, 1, r, haltStr, text_color = haltCol, text_size = dashFontSize, bgcolor = rb)
        r += 1
        zeb := not zeb
        rb := zeb ? TABLE_ROW_ALT : TABLE_BG
        table.cell(dashTable, 0, r, "Scaling", text_color = TEXT_MUTED, text_size = dashFontSize, bgcolor = rb)
        table.cell(dashTable, 1, r, scalingStr, text_color = TEXT_COLOR, text_size = dashFontSize, bgcolor = rb)
        r += 1
        zeb := not zeb

    table.cell(dashTable, 0, r, "LTM . " + INDICATOR_VERSION, text_color = TEXT_MUTED, text_size = dashFontSizeSub, text_halign = text.align_center)
    table.merge_cells(dashTable, 0, r, 1, r)

// ══════════════════════════════════════════════════════════
// 14. WATERMARK
// ══════════════════════════════════════════════════════════
if barstate.islast and showWatermarkInput
    var wmTable = table.new(
         position     = position.bottom_center,
         columns      = 1,
         rows         = 1,
         bgcolor      = color.new(color.black, 100),
         border_color = color.new(color.black, 100),
         border_width = 0,
         frame_color  = color.new(color.black, 100),
         frame_width  = 0)
    table.cell(wmTable, 0, 0, "WillyAlgoTrader",
         text_color  = WM_COLOR,
         text_size   = size.normal,
         text_halign = text.align_center,
         bgcolor     = color.new(color.black, 100))

// ══════════════════════════════════════════════════════════
// 15. ALERTS
// ══════════════════════════════════════════════════════════
string tick   = syminfo.tickerid
string tfStr  = timeframe.period
string aPrice = str.tostring(close, format.mintick)

if tp1FirstTouch and alertTpHitInput
    alert("| TP1 HEDEF | " + tick + " | TP1: " + str.tostring(nz(exitTP1), format.mintick), alert.freq_once_per_bar_close)

if tp2FirstTouch and alertTpHitInput
    alert("| TP2 HEDEF | " + tick + " | TP2: " + str.tostring(nz(exitTP2), format.mintick), alert.freq_once_per_bar_close)

if tp3FirstTouch and alertTpHitInput
    alert("| TP3 HEDEF | " + tick + " | TP3: " + str.tostring(nz(exitTP3), format.mintick), alert.freq_once_per_bar_close)

if evReversal and showReverseAlertInput
    string revDir = exitDir == 1 ? "Uzun -> Kisa" : "Kisa -> Uzun"
    string revRes = displayTp1Reached ? "TP1 sonrasi (kazanc)" : "TP1 oncesi (zarar)"
    alert("| TERS DONUS | " + tick + " | " + revDir + " | Onceki giris: " + str.tostring(nz(exitEntry), format.mintick) + " | Kapanis " + revRes, alert.freq_once_per_bar_close)

if evLongEntry or evShortEntry
    string aTP1   = str.tostring(nz(activeTP1), format.mintick)
    string aTP2   = str.tostring(nz(activeTP2), format.mintick)
    string aTP3   = str.tostring(nz(activeTP3), format.mintick)
    string aRR    = str.tostring(effTP1m, "#.#")
    string aScore = str.tostring(lastScore)

    if evLongEntry
        string jsonLong = '{"action":"buy","ticker":"' + tick + '","tf":"' + tfStr + '","price":' + aPrice + ',"score":' + aScore + ',"tp1":' + aTP1 + ',"tp2":' + aTP2 + ',"tp3":' + aTP3 + ',"rr":' + aRR + '}'
        string textLong = "UZUN | " + tick + " | TF: " + tfStr + " | Fiyat: " + aPrice + " | Skor: " + aScore + " | TP1: " + aTP1 + " | TP2: " + aTP2 + " | TP3: " + aTP3 + " | R:R: " + aRR
        alert(webhookInput ? jsonLong : textLong, alert.freq_once_per_bar_close)

    if evShortEntry
        string jsonShort = '{"action":"sell","ticker":"' + tick + '","tf":"' + tfStr + '","price":' + aPrice + ',"score":' + aScore + ',"tp1":' + aTP1 + ',"tp2":' + aTP2 + ',"tp3":' + aTP3 + ',"rr":' + aRR + '}'
        string textShort = "KISA | " + tick + " | TF: " + tfStr + " | Fiyat: " + aPrice + " | Skor: " + aScore + " | TP1: " + aTP1 + " | TP2: " + aTP2 + " | TP3: " + aTP3 + " | R:R: " + aRR
        alert(webhookInput ? jsonShort : textShort, alert.freq_once_per_bar_close)

if confirmedBullFlip and not evLongEntry and flipAlertInput
    alert("^ YUKSELIS DONUS | " + tick + " | TF: " + tfStr + " | Fiyat: " + aPrice, alert.freq_once_per_bar_close)

if confirmedBearFlip and not evShortEntry and flipAlertInput
    alert("v DUSUS DONUS | " + tick + " | TF: " + tfStr + " | Fiyat: " + aPrice, alert.freq_once_per_bar_close)

if lvnCross
    alert("| LVN KIRILIM | " + tick + " | TF: " + tfStr + " | Seviye: " + str.tostring(lvnCrossLvl, format.mintick) + " | Fiyat hacim bosluguna giriyor", alert.freq_once_per_bar_close)
