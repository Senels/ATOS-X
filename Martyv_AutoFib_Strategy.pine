//@version=6

strategy(title="Martyv Smart AutoFib Retracement Kit with Logarithmic Support", shorttitle="AutoFib", overlay=true, max_bars_back=300, max_lines_count=300, max_labels_count=300,
     initial_capital=100000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_value=0.1,
     commission_type=strategy.commission.percent,
     pyramiding=0)

var bullCol = color.new(#2962ff, 0)
var bearCol = color.new(#9c27b0, 0)
var neutralCol = color.new(#aa00ff, 50)
var whiteCol = color.new(#ffffff, 0)
var redCol = color.new(#e91e63, 0)

var pLabelOn = false
var fibOn = true
var line lineLast = na
var int iLast = 0
var int iPrev = 0
var float pLast = 0
var isHighLast = false
var startPrice = close
var endPrice = close

var logScale = input.bool(true, "Use logarithmic Scale", group="Fibonacci Retracement Settings")
contain = input.bool(true, "Contain Price Action (Allow Pre-valid Retrace)", group="Fibonacci Retracement Settings")
forceFib = input.bool(false, "Manual Fibonacci Levels (Inputs Below)", group="Fibonacci Retracement Settings")
reverseFib = input.bool(false, "Reverse", group="Fibonacci Retracement Settings")
var trendOn = false
var extendLeft = input.bool(false, "Extend Left  |  Extend Right", inline = "Extend Lines", group="Fibonacci Retracement Settings")
var extendRight = input.bool(false, "", inline = "Extend Lines", group="Fibonacci Retracement Settings")
var extending = extend.none
if extendLeft and extendRight
    extending := extend.both
if extendLeft and not extendRight
    extending := extend.left
if not extendLeft and extendRight
    extending := extend.right
prices = input.bool(true, "Show Prices", group="Fibonacci Retracement Settings")
levels = input.bool(true, "Show Levels", inline = "Levels", group="Fibonacci Retracement Settings")
levelsFormat = input.string("Values", "", options = ["Values", "Percent"], inline = "Levels", group="Fibonacci Retracement Settings")
labelsPosition = input.string("Right", "Labels Position", options = ["Left", "Right"], group="Fibonacci Retracement Settings")

showzigzag = false
fibZZlookPeriod = input.int(21, "Fibonacci Zig Zag Lookback", minval = 2, maxval = 55)

var fibo_ratios = array.new<float>()
var shownlevels = 1
if barstate.isfirst
    array.push(fibo_ratios, 0.000)
    array.push(fibo_ratios, 0.236)
    shownlevels += 1
    array.push(fibo_ratios, 0.382)
    shownlevels += 1
    array.push(fibo_ratios, 0.500)
    shownlevels += 1
    array.push(fibo_ratios, 0.618)
    shownlevels += 1
    array.push(fibo_ratios, 0.786)
    shownlevels += 1
    for x = 1 to 2
        array.push(fibo_ratios, x)
        array.push(fibo_ratios, x + 0.272)
        array.push(fibo_ratios, x + 0.414)
        array.push(fibo_ratios, x + 0.618)

float ph = ta.highestbars(high, fibZZlookPeriod) == 0 ? high : na
float pl = ta.lowestbars(low, fibZZlookPeriod) == 0 ? low : na

var dir = 0
dir := not na(ph) and na(pl) ? 1 : not na(pl) and na(ph) ? -1 : dir
var max_array_size = 10
var zigzag = array.new<float>()
var fibDir = 1

add_to_zigzag(value, bindex)=>
    array.unshift(zigzag, bindex)
    array.unshift(zigzag, value)
    if array.size(zigzag) > max_array_size
        array.pop(zigzag)
        array.pop(zigzag)

update_zigzag(value, bindex)=>
    if array.size(zigzag) == 0
        add_to_zigzag(value, bindex)
    else
        if (dir == 1 and value > array.get(zigzag, 0)) or (dir == -1 and value < array.get(zigzag, 0))
            array.set(zigzag, 0, value)
            array.set(zigzag, 1, bindex)
        float(0)

Round_it(value)=> math.round(value / syminfo.mintick) * syminfo.mintick

dirchanged = ta.change(dir) != 0
if not na(ph) or not na(pl)
    if dirchanged
        add_to_zigzag(dir == 1 ? ph : pl, bar_index)
    else
        update_zigzag(dir == 1 ? ph : pl, bar_index)

if fibOn and showzigzag and array.size(zigzag) >= 4
    var line zzline = na
    float val = array.get(zigzag, 0)
    int point = int(array.get(zigzag, 1))
    if ta.change(val) != 0 or ta.change(point) != 0
        float val1 = array.get(zigzag, 2)
        int point1 = int(array.get(zigzag, 3))
        if ta.change(val1) == 0 and ta.change(point1) == 0
            line.delete(zzline)
        zzline := line.new(x1 = point, y1 = val, x2 = point1, y2 = val1, color = dir == 1 ? bullCol : bearCol, width = 2, style=line.style_dashed)

var fibolines = array.new<line>()
if array.size(zigzag) >= 6 and barstate.islast
    if array.size(fibolines) > 0
        for x = 0 to array.size(fibolines) - 1
            line.delete(array.get(fibolines, x))
    diff = array.get(zigzag, 4) - array.get(zigzag, 2)
    p4 = array.get(zigzag, 4)
    p2 = array.get(zigzag, 2)
    p0 = array.get(zigzag, 0)
    outOfBounds = contain ? ((close > p4 and close > p2) or (close < p4 and close < p2)) or ((p0 > p4 and p0 > p2) or (p0 < p4 and p0 < p2)) : false
    startPrice := reverseFib ? array.get(zigzag, outOfBounds ? 2 : 4) : array.get(zigzag, outOfBounds ? 0 : 2)
    endPrice := reverseFib ? array.get(zigzag, outOfBounds ? 0 : 2) : array.get(zigzag, outOfBounds ? 2 : 4)
    fibDir := startPrice > endPrice ? 1 : -1
    stopit = false
    for x = 0 to array.size(fibo_ratios) - 1
        if (stopit and x > shownlevels) or fibOn != true
            break
        array.unshift(fibolines,
                      line.new(x1 = int(array.get(zigzag, outOfBounds ? 3 : 5)),
                               y1 = p2 + diff * array.get(fibo_ratios, x),
                               x2 = bar_index,
                               y2 = p2 + diff * array.get(fibo_ratios, x),
                               color = color.new(neutralCol, 100),
                               extend = extend.right))
        lineLast := array.get(fibolines, 0)
        if (dir == 1 and p2 + diff * array.get(fibo_ratios, x) > p0) or
           (dir == -1 and p2 + diff * array.get(fibo_ratios, x) < p0)
            stopit := true

showExt = false
show_ext = false
show_labels = false
channelLen = 21

upcol = bullCol
midcol = neutralCol
dncol = bearCol
os = 0
src = close
n = bar_index
var float valtop = na
var float valbtm = na

upper = ta.highest(src, channelLen)
lower = ta.lowest(src, channelLen)
os := src[channelLen] > upper ? 0 : src[channelLen] < lower ? 1 : os[1]
btm = os == 1 and os[1] != 1
top = os == 0 and os[1] != 0
btm_n = ta.valuewhen(btm, n, 0)
top_n = ta.valuewhen(top, n, 0)
len = math.abs(btm_n - top_n)

if btm
    max_diff_up = 0.
    max_diff_dn = 0.
    valbtm := low[channelLen]
    for i = 0 to len - 1
        point = low[channelLen] + i / (len - 1) * (valtop - low[channelLen])
        max_diff_up := math.max(math.max(src[channelLen + i], open[channelLen + i]) - point, max_diff_up)
        max_diff_dn := math.max(point - math.min(src[channelLen + i], open[channelLen + i]), max_diff_dn)
    if trendOn
        line.new(n[len + channelLen], valtop, n[channelLen], low[channelLen], color=midcol)
    if show_ext and trendOn
        line.new(n[len + channelLen], valtop + max_diff_up, n[channelLen], low[channelLen] + max_diff_up, color=upcol, style=line.style_dotted)
        line.new(n[len + channelLen], valtop - max_diff_dn, n[channelLen], low[channelLen] - max_diff_dn, color=dncol, style=line.style_dotted)
    if show_labels and trendOn
        label.new(n[channelLen], low[channelLen], str.tostring(low[channelLen], '#.####'), color=#00000000, style=label.style_label_up, textcolor=dncol, textalign=text.align_left, size=size.small)

if top
    max_diff_up = 0.
    max_diff_dn = 0.
    valtop := high[channelLen]
    for i = 0 to len - 1
        point = high[channelLen] + i / (len - 1) * (valbtm - high[channelLen])
        max_diff_up := math.max(math.max(src[channelLen + i], open[channelLen + i]) - point, max_diff_up)
        max_diff_dn := math.max(point - math.min(src[channelLen + i], open[channelLen + i]), max_diff_dn)
    if trendOn
        line.new(n[len + channelLen], valbtm, n[channelLen], high[channelLen], color=midcol)
    if show_ext and trendOn
        line.new(n[len + channelLen], valbtm + max_diff_up, n[channelLen], high[channelLen] + max_diff_up, color=upcol, style=line.style_dotted)
        line.new(n[len + channelLen], valbtm - max_diff_dn, n[channelLen], high[channelLen] - max_diff_dn, color=dncol, style=line.style_dotted)
    if show_labels and trendOn
        label.new(n[channelLen], high[channelLen], str.tostring(high[channelLen], '#.####'), color=#00000000, style=label.style_label_down, textcolor=upcol, textalign=text.align_left, size=size.small)

plot(btm ? low[channelLen] : top ? high[channelLen] : na, 'Circles', color = btm ? dncol : upcol, style=plot.style_circles, offset=-channelLen)

_draw_line(price, col, style) =>
    var id = line.new(iLast, price, bar_index, price, color=col, width=1, extend=extending, style = style == 1 ? line.style_solid : style == 2 ? line.style_dashed : line.style_dotted)
    if not na(lineLast)
        line.set_xy1(id, line.get_x1(lineLast), price)
        line.set_xy2(id, line.get_x2(lineLast), price)

_draw_label(price, txt, txtColor) =>
    x = labelsPosition == "Left" ? line.get_x1(lineLast) : not extendRight ? line.get_x2(lineLast) : bar_index
    labelStyle = labelsPosition == "Left" ? label.style_label_right : label.style_label_left
    align = labelsPosition == "Left" ? text.align_right : text.align_left
    labelsAlignStrLeft = txt
    labelsAlignStrRight = '             ' + txt
    labelsAlignStr = labelsPosition == "Left" ? labelsAlignStrLeft : labelsAlignStrRight
    var id = label.new(x=x, y=price, text=labelsAlignStr, textcolor=txtColor, style=labelStyle, textalign=align, color=#00000000)
    label.set_xy(id, x, price)
    label.set_text(id, labelsAlignStr)
    label.set_textcolor(id, txtColor)

_wrap(txt) =>
    if math.abs(txt) < 1
        "(" + str.tostring(txt, "#.####") + ")"
    else if math.abs(txt) >= 1 and math.abs(txt) < 50
        "(" + str.tostring(txt, "#.###") + ")"
    else
        "(" + str.tostring(txt, "#.##") + ")"

_label_txt(level, price) =>
    l = levelsFormat == "Values" ? str.tostring(level) : str.tostring(level * 100) + "%"
    (levels ? l : "") + (prices ? _wrap(price) : "")

_crossing_level(sr, r) =>
    (r > sr and r < sr[1]) or (r < sr and r > sr[1])

var vall1 = -0.65
var vall2 = -0.618
var vall3 = -0.382
var vall4 = -0.236
var vall5 = 0.
var vall6 = 0.236
var vall6a = 0.272
var vall7 = 0.382
var vall7a = 0.414
var vall8 = 0.5
var vall9 = 0.618
var vall10 = 0.65
var vall11 = 0.786
var vall12 = 0.886
var vall13 = 1.
var vall14 = 1.272
var vall15 = 1.414
var vall16 = 1.618
var vall16a = 1.886
var vall17 = 2.

var coll1 = #7b1fa2
var coll2 = #4a148c
var coll3 = #ab47bc
var coll4 = #ba68c8
var coll5 = #9575cd
var coll6 = #673ab7
var coll6a = #b39ddb
var coll7 = #b39ddb
var coll7a = #d1c4e9
var coll8 = #7e57c2
var coll9 = #673ab7
var coll10 = #9575cd
var coll11 = #673ab7
var coll12 = #9575cd
var coll13 = #9575cd
var coll14 = #5b9cf6
var coll15 = #3179f5
var coll16 = #0c3299
var coll16a = #1848cc
var coll17 = #1848cc

processLevel(show, value, colorL, lineStyle) =>
    if show
        float m = value
        if logScale
            iHL = startPrice > endPrice ? -1 : 1
            d = startPrice > endPrice ? math.abs(startPrice / endPrice) : math.abs(endPrice / startPrice)
            r = startPrice * math.pow(d, iHL * value)
            _draw_line(r, colorL, lineStyle)
            _draw_label(r, _label_txt(m, r), colorL)
        else
            iHL = startPrice > endPrice ? -1 : 1
            d = (startPrice > endPrice ? -1 : 1) * math.abs(startPrice - endPrice)
            r = startPrice + d * m
            _draw_line(r, colorL, lineStyle)
            _draw_label(r, _label_txt(m, r), colorL)
    true

processFibPrice(value) =>
    float m = value
    float r = startPrice
    if logScale
        iHL = startPrice > endPrice ? -1 : 1
        d = startPrice > endPrice ? math.abs(startPrice / endPrice) : math.abs(endPrice / startPrice)
        r := startPrice * math.pow(d, iHL * m)
    else
        iHL = startPrice > endPrice ? -1 : 1
        d = (startPrice > endPrice ? -1 : 1) * math.abs(startPrice - endPrice)
        r := startPrice + d * m
    r

show_neg_0_65 = input.bool(false, "", inline = "Level0", group="Fibonacci Levels")
value_neg_0_65 = input.float(vall1, "", inline = "Level0", group="Fibonacci Levels")
color_neg_0_65 = input.color(coll1, "", inline = "Level0", group="Fibonacci Levels")
y_neg_0_65 = processFibPrice(value_neg_0_65)

show_neg_0_618 = input.bool(false, "", inline = "Level0", group="Fibonacci Levels")
value_neg_0_618 = input.float(vall2, "", inline = "Level0", group="Fibonacci Levels")
color_neg_0_618 = input.color(coll2, "", inline = "Level0", group="Fibonacci Levels")
y_neg_0_618 = processFibPrice(value_neg_0_618)

show_neg_0_382 = input.bool(false, "", inline = "Level1", group="Fibonacci Levels")
value_neg_0_382 = input.float(vall3, "", inline = "Level1", group="Fibonacci Levels")
color_neg_0_382 = input.color(coll3, "", inline = "Level1", group="Fibonacci Levels")
y_neg_0_382 = processFibPrice(value_neg_0_382)

show_neg_0_236 = input.bool(true, "", inline = "Level1", group="Fibonacci Levels")
value_neg_0_236 = input.float(vall4, "", inline = "Level1", group="Fibonacci Levels")
color_neg_0_236 = input.color(coll4, "", inline = "Level1", group="Fibonacci Levels")
y_neg_0_236 = processFibPrice(value_neg_0_236)

show_0 = input.bool(true, "", inline = "Level2", group="Fibonacci Levels")
value_0 = input.float(vall5, "", inline = "Level2", group="Fibonacci Levels")
color_0 = input.color(coll5, "", inline = "Level2", group="Fibonacci Levels")
y_0 = processFibPrice(value_0)

show_0_236 = input.bool(true, "", inline = "Level2", group="Fibonacci Levels")
value_0_236 = input.float(vall6, "", inline = "Level2", group="Fibonacci Levels")
color_0_236 = input.color(coll6, "", inline = "Level2", group="Fibonacci Levels")
y_0_236 = processFibPrice(value_0_236)

show_0_272 = input.bool(true, "", inline = "Level3", group="Fibonacci Levels")
value_0_272 = input.float(vall6a, "", inline = "Level3", group="Fibonacci Levels")
color_0_272 = input.color(coll6a, "", inline = "Level3", group="Fibonacci Levels")
y_0_272 = processFibPrice(value_0_272)

show_0_382 = input.bool(true, "", inline = "Level3", group="Fibonacci Levels")
value_0_382 = input.float(vall7, "", inline = "Level3", group="Fibonacci Levels")
color_0_382 = input.color(coll7, "", inline = "Level3", group="Fibonacci Levels")
y_0_382 = processFibPrice(value_0_382)

show_0_414 = input.bool(true, "", inline = "Level4", group="Fibonacci Levels")
value_0_414 = input.float(vall7a, "", inline = "Level4", group="Fibonacci Levels")
color_0_414 = input.color(coll7a, "", inline = "Level4", group="Fibonacci Levels")
y_0_414 = processFibPrice(value_0_414)

show_0_5 = input.bool(true, "", inline = "Level4", group="Fibonacci Levels")
value_0_5 = input.float(vall8, "", inline = "Level4", group="Fibonacci Levels")
color_0_5 = input.color(coll8, "", inline = "Level4", group="Fibonacci Levels")
y_0_5 = processFibPrice(value_0_5)

show_0_618 = input.bool(true, "", inline = "Level5", group="Fibonacci Levels")
value_0_618 = input.float(vall9, "", inline = "Level5", group="Fibonacci Levels")
color_0_618 = input.color(coll9, "", inline = "Level5", group="Fibonacci Levels")
y_0_618 = processFibPrice(value_0_618)

show_0_65 = input.bool(true, "", inline = "Level5", group="Fibonacci Levels")
value_0_65 = input.float(vall10, "", inline = "Level5", group="Fibonacci Levels")
color_0_65 = input.color(coll10, "", inline = "Level5", group="Fibonacci Levels")
y_0_65 = processFibPrice(value_0_65)

show_0_786 = input.bool(true, "", inline = "Level6", group="Fibonacci Levels")
value_0_786 = input.float(vall11, "", inline = "Level6", group="Fibonacci Levels")
color_0_786 = input.color(coll11, "", inline = "Level6", group="Fibonacci Levels")
y_0_786 = processFibPrice(value_0_786)

show_0_886 = input.bool(true, "", inline = "Level6", group="Fibonacci Levels")
value_0_886 = input.float(vall12, "", inline = "Level6", group="Fibonacci Levels")
color_0_886 = input.color(coll12, "", inline = "Level6", group="Fibonacci Levels")
y_0_886 = processFibPrice(value_0_886)

show_1 = input.bool(true, "", inline = "Level7", group="Fibonacci Levels")
value_1 = input.float(vall13, "", inline = "Level7", group="Fibonacci Levels")
color_1 = input.color(coll13, "", inline = "Level7", group="Fibonacci Levels")
y_1 = processFibPrice(value_1)

show_1_272 = input.bool(true, "", inline = "Level7", group="Fibonacci Levels")
value_1_272 = input.float(vall14, "", inline = "Level7", group="Fibonacci Levels")
color_1_272 = input.color(coll14, "", inline = "Level7", group="Fibonacci Levels")
y_1_272 = processFibPrice(value_1_272)

show_1_414 = input.bool(false, "", inline = "Level8", group="Fibonacci Levels")
value_1_414 = input.float(vall15, "", inline = "Level8", group="Fibonacci Levels")
color_1_414 = input.color(coll15, "", inline = "Level8", group="Fibonacci Levels")
y_1_414 = processFibPrice(value_1_414)

show_1_618 = input.bool(false, "", inline = "Level8", group="Fibonacci Levels")
value_1_618 = input.float(vall16, "", inline = "Level8", group="Fibonacci Levels")
color_1_618 = input.color(coll16, "", inline = "Level8", group="Fibonacci Levels")
y_1_618 = processFibPrice(value_1_618)

show_1_886 = input.bool(false, "", inline = "Level9", group="Fibonacci Levels")
value_1_886 = input.float(vall16a, "", inline = "Level9", group="Fibonacci Levels")
color_1_886 = input.color(coll16a, "", inline = "Level9", group="Fibonacci Levels")
y_1_886 = processFibPrice(value_1_886)

show_2 = input.bool(false, "", inline = "Level9", group="Fibonacci Levels")
value_2 = input.float(vall17, "", inline = "Level9", group="Fibonacci Levels")
color_2 = input.color(coll17, "", inline = "Level9", group="Fibonacci Levels")
y_2 = processFibPrice(value_2)

processLevel(forceFib ? show_neg_0_65 : fibDir == 1 and close > y_neg_0_618 or fibDir == -1 and close < y_neg_0_618 ? forceFib ? show_neg_0_65 : true : show_neg_0_65, value_neg_0_65, color_neg_0_65, 3)
processLevel(forceFib ? show_neg_0_618 : fibDir == 1 and close > y_neg_0_382 or fibDir == -1 and close < y_neg_0_382 ? forceFib ? show_neg_0_618 : true : show_neg_0_618, value_neg_0_618, color_neg_0_618, 3)
processLevel(forceFib ? show_neg_0_382 : fibDir == 1 and close > y_neg_0_236 or fibDir == -1 and close < y_neg_0_236 ? forceFib ? show_neg_0_382 : true : show_neg_0_382, value_neg_0_382, color_neg_0_382, 3)
processLevel(forceFib ? show_neg_0_236 : fibDir == 1 and close > y_0 or fibDir == -1 and close < y_0 ? forceFib ? show_neg_0_236 : true : show_neg_0_236, value_neg_0_236, color_neg_0_236, 3)
processLevel(forceFib ? show_0 : show_0, value_0, color_0, 1)
processLevel(forceFib ? show_0_236 : show_0_236, value_0_236, color_0_236, 1)
processLevel(forceFib ? show_0_272 : show_0_272, value_0_272, color_0_272, 3)
processLevel(forceFib ? show_0_382 : show_0_382, value_0_382, color_0_382, 1)
processLevel(forceFib ? show_0_414 : show_0_414, value_0_414, color_0_414, 3)
processLevel(forceFib ? show_0_5 : show_0_5, value_0_5, color_0_5, 2)
processLevel(forceFib ? show_0_618 : show_0_618, value_0_618, color_0_618, 1)
processLevel(forceFib ? show_0_65 : show_0_65, value_0_65, color_0_65, 3)
processLevel(forceFib ? show_0_786 : show_0_786, value_0_786, color_0_786, 1)
processLevel(forceFib ? show_0_886 : show_0_886, value_0_886, color_0_886, 3)
processLevel(forceFib ? show_1 : show_1, value_1, color_1, 1)
processLevel(forceFib ? show_1_272 : fibDir == -1 and close > y_1 or fibDir == 1 and close < y_1 ? forceFib ? show_1_272 : true : show_1_272, value_1_272, color_1_272, 3)
processLevel(forceFib ? show_1_414 : fibDir == -1 and close > y_1_272 or fibDir == 1 and close < y_1_272 ? forceFib ? show_1_414 : true : show_1_414, value_1_414, color_1_414, 3)
processLevel(forceFib ? show_1_618 : fibDir == -1 and close > y_1_414 or fibDir == 1 and close < y_1_414 ? forceFib ? show_1_618 : true : show_1_618, value_1_618, color_1_618, 3)
processLevel(forceFib ? show_1_886 : fibDir == -1 and close > y_1_618 or fibDir == 1 and close < y_1_618 ? forceFib ? show_1_886 : true : show_1_886, value_1_886, color_2, 3)
processLevel(forceFib ? show_2 : fibDir == -1 and close > y_1_886 or fibDir == 1 and close < y_1_886 ? forceFib ? show_2 : true : show_2, value_2, color_2, 3)

// STRATEGY
stratEnabled = input.bool(true, "Enable Strategy", group="Strategy Settings")
stratLong = input.bool(true, "Long Trades", group="Strategy Settings")
stratShort = input.bool(true, "Short Trades", group="Strategy Settings")
stratEntryLev = input.float(0.618, "Entry", group="Strategy Settings", step=0.001)
stratTPLev = input.float(1.0, "TP", group="Strategy Settings", step=0.001)
stratSLLev = input.float(0.382, "SL", group="Strategy Settings", step=0.001)

stratFibPrice(ratio, sp, ep) =>
    float result = sp
    if logScale
        iHL = sp > ep ? -1 : 1
        d = sp > ep ? math.abs(sp / ep) : math.abs(ep / sp)
        result := sp * math.pow(d, iHL * ratio)
    else
        iHL = sp > ep ? -1 : 1
        d = (sp > ep ? -1 : 1) * math.abs(sp - ep)
        result := sp + d * ratio
    result

var float stratStart = na
var float stratEnd = na
var int stratDir = 0
var float stratEntryPrice = na
var float stratTPPrice = na
var float stratSLPrice = na

if array.size(zigzag) >= 6
    p4 = array.get(zigzag, 4)
    p2 = array.get(zigzag, 2)
    p0 = array.get(zigzag, 0)
    _oob = contain ? ((close > p4 and close > p2) or (close < p4 and close < p2)) or ((p0 > p4 and p0 > p2) or (p0 < p4 and p0 < p2)) : false
    stratStart := reverseFib ? array.get(zigzag, _oob ? 2 : 4) : array.get(zigzag, _oob ? 0 : 2)
    stratEnd := reverseFib ? array.get(zigzag, _oob ? 0 : 2) : array.get(zigzag, _oob ? 2 : 4)
    stratDir := stratStart > stratEnd ? 1 : -1
    stratEntryPrice := stratFibPrice(stratEntryLev, stratStart, stratEnd)
    stratTPPrice := stratFibPrice(stratTPLev, stratStart, stratEnd)
    stratSLPrice := stratFibPrice(stratSLLev, stratStart, stratEnd)

fibDetected = stratDir != 0
buySignal = fibDetected and stratDir == -1 and ta.crossover(close, stratEntryPrice)
sellSignal = fibDetected and stratDir == 1 and ta.crossunder(close, stratEntryPrice)

var float buyTP = na
var float buySL = na
var float sellTP = na
var float sellSL = na

if buySignal and stratEnabled and stratLong
    buyTP := stratTPPrice
    buySL := stratSLPrice
    strategy.entry("Long", strategy.long)

if sellSignal and stratEnabled and stratShort
    sellTP := stratTPPrice
    sellSL := stratSLPrice
    strategy.entry("Short", strategy.short)

if strategy.position_size > 0
    strategy.exit("LX", "Long", limit=buyTP, stop=buySL)

if strategy.position_size < 0
    strategy.exit("SX", "Short", limit=sellTP, stop=sellSL)
