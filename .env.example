# ATOS X environment
APP_ENV=dev
LOG_LEVEL=INFO

# Database (docker-compose defaults)
DATABASE_URL=postgresql+asyncpg://atosx:atosx@localhost:5432/atosx
REDIS_URL=redis://localhost:6379/0

# Binance USDM Futures (testnet recommended)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# Risk defaults
LEVERAGE=10
MAX_CONCURRENT_POSITIONS=4
RISK_PER_TRADE_PCT=0.30
KELLY_FRACTIONAL=0.50
SL_ATR_MULT=1.5
TP_ATR_MULT=6.0
TRAIL_ACTIVATION_MULT=0.3
TRAIL_DISTANCE_MULT=1.5
