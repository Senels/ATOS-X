//@version=6
strategy(title="XAU O>O[1] Futures", shorttitle="XAU O>O[1]", overlay=true,
         initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=50,
         commission_type=strategy.commission.percent, commission_value=0.04, pyramiding=0,
         process_orders_on_close=true)

trailPct     = input.float(0.7, "Trail (%)", minval=0.01, step=0.1)
posSize      = input.float(50, "Position Size (%)", minval=1, maxval=100, step=5)
tradeDir     = input.string("Both", "Direction", options=["Both", "Long Only", "Short Only"])
useTrail     = input.bool(true, "Use Trailing Stop")
slippageTicks = input.int(2, "Slippage (ticks)", minval=0, maxval=10)

tradeLong    = tradeDir == "Both" or tradeDir == "Long Only"
tradeShort   = tradeDir == "Both" or tradeDir == "Short Only"

if tradeLong and open > open[1]
    strategy.entry("L", strategy.long, qty=strategy.equity * posSize / 100 / close)

if tradeShort and open < open[1]
    strategy.entry("S", strategy.short, qty=strategy.equity * posSize / 100 / close)

if useTrail
    if strategy.position_size > 0
        trailPts = int((strategy.position_avg_price * trailPct / 100) / syminfo.mintick)
        strategy.exit("XL", "L", trail_points=trailPts, trail_offset=slippageTicks)
    if strategy.position_size < 0
        trailPts = int((strategy.position_avg_price * trailPct / 100) / syminfo.mintick)
        strategy.exit("XS", "S", trail_points=trailPts, trail_offset=slippageTicks)
