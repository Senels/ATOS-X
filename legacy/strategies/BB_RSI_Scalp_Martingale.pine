//@version=6
strategy("BB RSI Scalp 1min", shorttitle="BB_RSI_1m",
     overlay=true, pyramiding=0, initial_capital=10000,
     commission_type=strategy.commission.percent, commission_value=0.04,
     slippage=1)

rsiLen  = input.int(2, "RSI")
rsiOS   = input.int(25, "RSI OS")
rsiOB   = input.int(75, "RSI OB")

bbLen   = input.int(10, "BB Period")
bbMult  = input.float(1.5, "BB StdDev")

atrLen  = input.int(3, "ATR")
tpMult  = input.float(1.2, "TP xATR")
slMult  = input.float(1.2, "SL xATR")

bQty    = input.float(0.2, "Base Qty")
qMult   = input.float(1.5, "Qty Mult")
maxLvl  = input.int(4, "Max Lvl")

vrsi = ta.rsi(close, rsiLen)
[_, bbUpper, bbLower] = ta.bb(close, bbLen, bbMult)
atr  = ta.atr(atrLen)

longSignal  = ta.crossover(vrsi, rsiOS) and close >= bbLower
shortSignal = ta.crossunder(vrsi, rsiOB) and close <= bbUpper

var int lossCount = 0
var float entryPx = 0.0

if longSignal and strategy.position_size <= 0
    int lvl    = math.min(lossCount, maxLvl - 1)
    float size = bQty * math.pow(qMult, lvl)
    float maxCost = strategy.equity * 0.3
    int qty = int(math.floor(maxCost / (close * size)))
    qty := math.max(qty, 1)
    entryPx := close
    strategy.entry("L", strategy.long, qty = qty)
    strategy.exit("Lx", "L", limit = entryPx + atr * tpMult, stop = entryPx - atr * slMult)

if shortSignal and strategy.position_size >= 0
    int lvl    = math.min(lossCount, maxLvl - 1)
    float size = bQty * math.pow(qMult, lvl)
    float maxCost = strategy.equity * 0.3
    int qty = int(math.floor(maxCost / (close * size)))
    qty := math.max(qty, 1)
    entryPx := close
    strategy.entry("S", strategy.short, qty = qty)
    strategy.exit("Sx", "S", limit = entryPx - atr * tpMult, stop = entryPx + atr * slMult)

// Martingale loss tracking: position kapandığında
if strategy.position_size[1] != 0 and strategy.position_size == 0
    float prevEq = strategy.equity[1]
    if strategy.equity >= prevEq
        lossCount := 0
    else
        lossCount := math.min(lossCount + 1, maxLvl - 1)

plot(bbUpper, "BB U", color.silver)
plot(bbLower, "BB L", color.silver)
plotshape(longSignal, "L", shape.triangleup, location.belowbar, color.green, size=size.tiny)
plotshape(shortSignal, "S", shape.triangledown, location.abovebar, color.red, size=size.tiny)
