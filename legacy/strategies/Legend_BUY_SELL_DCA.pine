//@version=6
// Legend BUY SELL DCA — MACD + ADX + Martingale Averaging
// XAUUSDT 1m — Dinamik TP (ortalamaya gore), ayarlanabilir DCA

strategy(
     title       = "Legend BUY SELL DCA",
     shorttitle  = "LBS DCA",
     overlay     = true,
     process_orders_on_close = true,
     pyramiding  = 10,
     initial_capital  = 10000,
     commission_type  = strategy.commission.percent,
     commission_value = 0.04,
     slippage    = 1)

// ═══════════════ INPUTS ═══════════════

// MACD
fast_length   = input.int(5,  "Hizli EMA", group = "MACD")
slow_length   = input.int(13, "Yavas EMA", group = "MACD")
src           = input.source(close, "Kaynak", group = "MACD")
signal_length = input.int(9,  "Signal Yumusatma", minval = 1, maxval = 50, group = "MACD")

// ADX
adxlen        = input.int(14, "ADX Yumusatma", group = "ADX")
dilen         = input.int(10, "DI Uzunlugu", group = "ADX")
adx_threshold = input.float(35.0, "ADX Esik", step = 0.5, group = "ADX")

// Risk
riskPctInput  = input.float(1.0, "Risk / Trade (%)", minval = 0.1, maxval = 10.0, step = 0.1, group = "Risk")
atrLenInput   = input.int(10, "ATR Uzunlugu", minval = 3, maxval = 50, group = "Risk")
tpBaseMult    = input.float(1.5, "TP Taban Carpani (xATR)", minval = 0.5, maxval = 5.0, step = 0.1, group = "Risk")
tpMult        = input.float(1.5, "TP Carpani (xTaban)", minval = 0.5, maxval = 5.0, step = 0.1, group = "Risk")

// DCA
dcaSpacing    = input.float(3.0, "DCA Araligi (xATR)", minval = 0.5, maxval = 5.0, step = 0.1, group = "DCA")
dcaMaxLevels  = input.int(3, "Maksimum DCA Seviye", minval = 1, maxval = 10, group = "DCA")
dcaMultiplier = input.float(2.0, "DCA Boyut Carpani", minval = 1.0, maxval = 3.0, step = 0.1, group = "DCA")

// ═══════════════ MACD + ADX ═══════════════

fast_ma = ta.ema(src, fast_length)
slow_ma = ta.ema(src, slow_length)
macd    = fast_ma - slow_ma
signal  = ta.ema(macd, signal_length)

dirmov(simple int len) =>
    float up      = ta.change(high)
    float down    = -ta.change(low)
    float plusDM  = na(up) ? na : up > down and up > 0 ? up : 0
    float minusDM = na(down) ? na : down > up and down > 0 ? down : 0
    float tr_     = ta.rma(ta.tr(true), len)
    float plus    = fixnan(100 * ta.rma(plusDM, len) / tr_)
    float minus   = fixnan(100 * ta.rma(minusDM, len) / tr_)
    [plus, minus]

adxFunc(simple int diLen, simple int adxLen) =>
    [plus_, minus_] = dirmov(diLen)
    float sum_ = plus_ + minus_
    float adx_ = 100 * ta.rma(math.abs(plus_ - minus_) / (sum_ == 0 ? 1 : sum_), adxLen)
    adx_

sig = adxFunc(dilen, adxlen)

macdCrossUpRaw   = ta.crossover(macd, signal)
macdCrossDownRaw = ta.crossunder(macd, signal)

macdCrossUp   = macd < 0 and macdCrossUpRaw
macdCrossDown = macd > 0 and macdCrossDownRaw

bool bullish = sig > adx_threshold and macdCrossUp
bool bearish = sig > adx_threshold and macdCrossDown

// ═══════════════ RISK ═══════════════

float riskAtr     = nz(ta.atr(atrLenInput), 0.0)
float tpDistance  = riskAtr * tpBaseMult
float tpTarget    = tpDistance * tpMult

calcPositionQty(float entryPrice) =>
    riskCap_ = strategy.equity * riskPctInput / 100.0
    pv_      = nz(syminfo.pointvalue, 1)
    riskPc_  = tpDistance * pv_
    riskQ_   = riskPc_ > 0 ? math.floor(riskCap_ / riskPc_) : 999999
    marginQ_ = math.floor(strategy.equity / (entryPrice * pv_))
    int(math.max(math.min(riskQ_, math.max(marginQ_, 1)), 1))

// ═══════════════ STATE ═══════════════

var float activeEntry  = na
var float activeTP     = na
var int   activeDir    = 0
var int   entryBarIdx  = na
var bool  tpReached    = false

var int   dcaLevel     = 1
var float dcaBaseEntry = na
var int   entryBaseQty = 0

// Weighted average tracking
var float cumQty = 0.0
var float cumCost = 0.0

bool warmedUp = bar_index > atrLenInput * 3

// ═══════════════ ENTRIES ═══════════════

if activeDir == 0 and barstate.isconfirmed and warmedUp
    if bullish
        activeEntry  := close
        activeTP     := close + tpTarget
        activeDir    := 1
        entryBarIdx  := bar_index
        tpReached    := false
        dcaLevel     := 1
        dcaBaseEntry := close
        entryBaseQty := calcPositionQty(close)
        cumQty       := entryBaseQty
        cumCost      := entryBaseQty * close
        strategy.entry("L", strategy.long, qty = entryBaseQty)
    if bearish
        activeEntry  := close
        activeTP     := close - tpTarget
        activeDir    := -1
        entryBarIdx  := bar_index
        tpReached    := false
        dcaLevel     := 1
        dcaBaseEntry := close
        entryBaseQty := calcPositionQty(close)
        cumQty       := entryBaseQty
        cumCost      := entryBaseQty * close
        strategy.entry("S", strategy.short, qty = entryBaseQty)

// ═══════════════ DCA AVERAGING ═══════════════

if activeDir != 0 and not na(dcaBaseEntry) and barstate.isconfirmed and not tpReached
    float spacing_ = riskAtr * dcaSpacing
    if activeDir == 1
        for lvl = 2 to dcaMaxLevels
            if lvl > dcaLevel
                float trig_ = dcaBaseEntry - (lvl - 1) * spacing_
                if low <= trig_
                    dcaLevel := lvl
                    float newQty = entryBaseQty * math.pow(dcaMultiplier, lvl - 1)
                    cumQty  := cumQty + newQty
                    cumCost := cumCost + newQty * close
                    float avgEntry = cumCost / cumQty
                    activeTP := avgEntry + tpTarget
                    strategy.entry("L_M" + str.tostring(lvl), strategy.long, qty = int(newQty))
    if activeDir == -1
        for lvl = 2 to dcaMaxLevels
            if lvl > dcaLevel
                float trig_ = dcaBaseEntry + (lvl - 1) * spacing_
                if high >= trig_
                    dcaLevel := lvl
                    float newQty = entryBaseQty * math.pow(dcaMultiplier, lvl - 1)
                    cumQty  := cumQty + newQty
                    cumCost := cumCost + newQty * close
                    float avgEntry = cumCost / cumQty
                    activeTP := avgEntry - tpTarget
                    strategy.entry("S_M" + str.tostring(lvl), strategy.short, qty = int(newQty))

// ═══════════════ TP DETECTION & CLOSE ═══════════════

bool canCheck = activeDir != 0 and not na(entryBarIdx) and bar_index > entryBarIdx and barstate.isconfirmed
bool tpNow = canCheck and (activeDir == 1 ? high >= activeTP : low <= activeTP)

if tpNow
    tpReached := true

if tpReached and activeDir != 0
    if activeDir == 1
        strategy.close("L")
        for lvl = 2 to dcaMaxLevels
            strategy.close("L_M" + str.tostring(lvl))
    if activeDir == -1
        strategy.close("S")
        for lvl = 2 to dcaMaxLevels
            strategy.close("S_M" + str.tostring(lvl))
    activeDir    := 0
    activeEntry  := na
    activeTP     := na
    entryBarIdx  := na
    tpReached    := false
    dcaLevel     := 1
    dcaBaseEntry := na
    entryBaseQty := 0
    cumQty       := 0
    cumCost      := 0

// ═══════════════ REVERSAL ═══════════════

bool revLong  = activeDir == -1 and bullish and barstate.isconfirmed and warmedUp
bool revShort = activeDir == 1 and bearish and barstate.isconfirmed and warmedUp

if revLong or revShort
    if activeDir == 1
        strategy.close("L")
        for lvl = 2 to dcaMaxLevels
            strategy.close("L_M" + str.tostring(lvl))
    if activeDir == -1
        strategy.close("S")
        for lvl = 2 to dcaMaxLevels
            strategy.close("S_M" + str.tostring(lvl))
    activeDir    := 0
    activeEntry  := na
    activeTP     := na
    entryBarIdx  := na
    tpReached    := false
    dcaLevel     := 1
    dcaBaseEntry := na
    entryBaseQty := 0
    cumQty       := 0
    cumCost      := 0

    if revLong
        activeEntry  := close
        activeTP     := close + tpTarget
        activeDir    := 1
        entryBarIdx  := bar_index
        dcaBaseEntry := close
        entryBaseQty := calcPositionQty(close)
        cumQty       := entryBaseQty
        cumCost      := entryBaseQty * close
        strategy.entry("L", strategy.long, qty = entryBaseQty)
    if revShort
        activeEntry  := close
        activeTP     := close - tpTarget
        activeDir    := -1
        entryBarIdx  := bar_index
        dcaBaseEntry := close
        entryBaseQty := calcPositionQty(close)
        cumQty       := entryBaseQty
        cumCost      := entryBaseQty * close
        strategy.entry("S", strategy.short, qty = entryBaseQty)

// ═══════════════ VISUALS ═══════════════

plotshape(bullish, style = shape.labelup,   location = location.belowbar, color = color.green, text = "AL",  textcolor = color.white, size = size.small)
plotshape(bearish, style = shape.labeldown, location = location.abovebar, color = color.red,   text = "SAT", textcolor = color.white, size = size.small)
