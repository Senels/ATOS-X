//@version=6
strategy("WaveTrend Scalp 1min", shorttitle="WT_Scalp",
     overlay=false, pyramiding=0, initial_capital=10000,
     commission_type=strategy.commission.percent, commission_value=0.04,
     slippage=1)

n1  = input.int(9, "WT Channel Len")
n2  = input.int(25, "WT Average Len")
ob1 = input.int(60, "OverBought 1")
ob2 = input.int(40, "OverBought 2")
os1 = input.int(-55, "OverSold 1")
os2 = input.int(-50, "OverSold 2")

atrLen = input.int(5, "ATR Length")
tpMult = input.float(1.5, "TP xATR")
slMult = input.float(1.5, "SL xATR")
bQty   = input.float(0.2, "Base Qty")
qMult  = input.float(1.5, "Qty Mult")
maxLvl = input.int(4, "Max Levels")

// WaveTrend
ap  = hlc3
esa = ta.ema(ap, n1)
d   = ta.ema(math.abs(ap - esa), n1)
ci  = (ap - esa) / (0.015 * d)
tci = ta.ema(ci, n2)
wt1 = tci
wt2 = ta.sma(wt1, 4)

longSignal  = ta.crossover(wt1, wt2)
shortSignal = ta.crossunder(wt1, wt2)

atr = ta.atr(atrLen)

var int lossCount = 0
var float entryPx = 0.0

if longSignal and strategy.position_size <= 0
    int lvl = math.min(lossCount, maxLvl - 1)
    float size = bQty * math.pow(qMult, lvl)
    float maxCost = strategy.equity * 0.3
    int qty = int(math.floor(maxCost / (close * size)))
    qty := math.max(qty, 1)
    entryPx := close
    strategy.entry("L", strategy.long, qty = qty)
    strategy.exit("Lx", "L", limit = entryPx + atr * tpMult, stop = entryPx - atr * slMult)

if shortSignal and strategy.position_size >= 0
    int lvl = math.min(lossCount, maxLvl - 1)
    float size = bQty * math.pow(qMult, lvl)
    float maxCost = strategy.equity * 0.3
    int qty = int(math.floor(maxCost / (close * size)))
    qty := math.max(qty, 1)
    entryPx := close
    strategy.entry("S", strategy.short, qty = qty)
    strategy.exit("Sx", "S", limit = entryPx - atr * tpMult, stop = entryPx + atr * slMult)

if strategy.position_size[1] != 0 and strategy.position_size == 0
    if strategy.equity >= strategy.equity[1]
        lossCount := 0
    else
        lossCount := math.min(lossCount + 1, maxLvl - 1)

hline(0, "Zero", color.gray)
hline(ob1, "OB1", color.red)
hline(os1, "OS1", color.green)
hline(ob2, "OB2", color.red, linestyle=hline.style_dotted)
hline(os2, "OS2", color.green, linestyle=hline.style_dotted)

plot(wt1, "WT1", color.green)
plot(wt2, "WT2", color.red)
fill(plot(wt1), plot(wt2), wt1 > wt2 ? color.new(color.green, 85) : color.new(color.red, 85))

plotshape(longSignal, "L", shape.triangleup, location.bottom, color.green, size=size.tiny)
plotshape(shortSignal, "S", shape.triangledown, location.top, color.red, size=size.tiny)
