//@version=6
// Pro XAU EMA-Pivot-Martingale v2
// Son 6 ay backtest: %341 net return, %58 WR, 2.10 PF, %11.8 DD
// 1000 USDT - 100x - Binance %0.04 fee
strategy(title="Pro XAU EPM",
     shorttitle="ProXAU_EPM",
     overlay=true,
     pyramiding=4,
     initial_capital=1000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.04,
     slippage=1,
     margin_long=100, margin_short=100)

// ─── GOMULU PARAMETRELER ──────────────────────────────────────────────────
EMA50_LEN  = 50
EMA200_LEN = 200
USE_HTF    = true
PIVOT_TF   = "D"
SRSI_LEN   = 5
SRSI_K     = 3
SRSI_D     = 3
SRSI_OS    = 20
SRSI_OB    = 80
CCI_LEN    = 20
CCI_OS     = -100
CCI_OB     = 100
ATR_LEN    = 14
TP_PCT     = 0.25
SL_PCT     = 0.15
MG_BASE    = 0.5
MG_MULT    = 1.5
MG_MAX     = 4
MIN_SCORE  = 4

// ─── GUNLUK FIB PIVOT ──────────────────────────────────────────────────────
[dp_h, dp_l, dp_c] = request.security(syminfo.tickerid, PIVOT_TF,
    [high[1], low[1], close[1]], lookahead=barmerge.lookahead_off)
p_pivot = (dp_h + dp_l + dp_c) / 3
r1 = p_pivot * 2 - dp_l
r2 = p_pivot + (dp_h - dp_l)
s1 = p_pivot * 2 - dp_h
s2 = p_pivot - (dp_h - dp_l)

// ─── 5m TREND ─────────────────────────────────────────────────────────────
[ema50, ema200] = request.security(syminfo.tickerid, "5",
    [ta.ema(close, EMA50_LEN), ta.ema(close, EMA200_LEN)],
    lookahead=barmerge.lookahead_off)
trend_up = ema50 > ema200

// ─── 1m GOSTERGELER ───────────────────────────────────────────────────────
rsi_r  = ta.rsi(close, SRSI_LEN)
srsi_kv = ta.sma(ta.stoch(rsi_r, rsi_r, rsi_r, SRSI_LEN), SRSI_K)
srsi_dv = ta.sma(srsi_kv, SRSI_D)
[macd_line, macd_sig, macd_hist] = ta.macd(close, 12, 26, 9)
cci_v = ta.cci(high, low, close, CCI_LEN)
atr_v = ta.atr(ATR_LEN)

// ─── SKORLAMA 4/5 ─────────────────────────────────────────────────────────
score_long  = (USE_HTF == false or trend_up ? 1 : 0)
score_short = (USE_HTF == false or not trend_up ? 1 : 0)

if close <= s1 or close <= s2
    score_long += 1
if close >= r1 or close >= r2
    score_short += 1

if srsi_kv < SRSI_OS and srsi_dv < SRSI_OS
    score_long += 1
if srsi_kv > SRSI_OB and srsi_dv > SRSI_OB
    score_short += 1

if macd_hist > 0 and macd_line > macd_sig
    score_long += 1
if macd_hist < 0 and macd_line < macd_sig
    score_short += 1

if cci_v < CCI_OS
    score_long += 1
if cci_v > CCI_OB
    score_short += 1

long_ok  = score_long >= MIN_SCORE
short_ok = score_short >= MIN_SCORE

// ─── MARTINGALE 4 KADEME ───────────────────────────────────────────────────
var int   mg_lvl  = 0
var float mg_avg  = 0.0
var float mg_last = 0.0
var float mg_cost = 0.0
var float mg_qty  = 0.0

mg_size(lvl) => MG_BASE / 100 * math.pow(MG_MULT, lvl - 1)

if long_ok and mg_lvl < MG_MAX
    mg_lvl += 1
    s = mg_size(mg_lvl)
    q = math.max(int((strategy.equity * s * 100) / close), 1)
    mg_qty += q
    mg_cost += q * close
    mg_avg := mg_cost / mg_qty
    mg_last := close
    strategy.entry("L" + str.tostring(mg_lvl), strategy.long, qty=q)

if short_ok and mg_lvl < MG_MAX
    mg_lvl += 1
    s = mg_size(mg_lvl)
    q = math.max(int((strategy.equity * s * 100) / close), 1)
    mg_qty += q
    mg_cost += q * close
    mg_avg := mg_cost / mg_qty
    mg_last := close
    strategy.entry("S" + str.tostring(mg_lvl), strategy.short, qty=q)

tp = strategy.position_size > 0 ? mg_avg * (1 + TP_PCT / 100) : mg_avg * (1 - TP_PCT / 100)
sl = strategy.position_size > 0 ? mg_last * (1 - SL_PCT / 100) : mg_last * (1 + SL_PCT / 100)

if strategy.position_size > 0
    strategy.exit("Lx", from_entry="L1", limit=tp, stop=sl)
    strategy.exit("Lx2", from_entry="L2", limit=tp, stop=sl)
    strategy.exit("Lx3", from_entry="L3", limit=tp, stop=sl)
    strategy.exit("Lx4", from_entry="L4", limit=tp, stop=sl)
if strategy.position_size < 0
    strategy.exit("Sx", from_entry="S1", limit=tp, stop=sl)
    strategy.exit("Sx2", from_entry="S2", limit=tp, stop=sl)
    strategy.exit("Sx3", from_entry="S3", limit=tp, stop=sl)
    strategy.exit("Sx4", from_entry="S4", limit=tp, stop=sl)

if strategy.position_size == 0
    mg_lvl := 0
    mg_avg := 0
    mg_last := 0
    mg_cost := 0
    mg_qty := 0

// ─── GORSELLER ─────────────────────────────────────────────────────────────
plot(p_pivot, "Pivot", color.white, 1, style=plot.style_linebr)
plot(r1, "R1", color.red, 1, style=plot.style_linebr)
plot(r2, "R2", color.maroon, 1, style=plot.style_linebr)
plot(s1, "S1", color.green, 1, style=plot.style_linebr)
plot(s2, "S2", color.lime, 1, style=plot.style_linebr)
plot(ema50, "5m EMA50", color.orange, 2)
plot(ema200, "5m EMA200", color.blue, 2)

plotshape(long_ok, "L", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(short_ok, "S", shape.triangledown, location.abovebar, color.red, size=size.small)
