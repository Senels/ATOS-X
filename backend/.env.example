# Binance API Keys (bos = public endpoint'ler calisir; emir icin gerekli)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_TESTNET=True

# Paper mod: True = emirler borsaya gitmez, simule edilir
PAPER_TRADING=True

# Canli emir kill-switch'i: False iken yeni pozisyon ACIS emirleri kod seviyesinde
# engellenir. Canliya gecmek icin PAPER_TRADING=False + BINANCE_TESTNET=False +
# LIVE_TRADING_ENABLED=True ucunun birlikte ayarlanmasi gerekir.
LIVE_TRADING_ENABLED=False

# Minimum pozisyon notionali (USDT); 0 = devre disi
MIN_NOTIONAL=0

# Telegram (token + chat_id ikisi de doluysa bildirim aktif)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Guvenlik
# Bos = /api/v1 REST uclari korumasiz (dev/test); dolu = tum uclarda X-API-Key header'i zorunlu
API_KEY=
# Virgulle ayrilmis izinli Telegram chat_id listesi (bos = filtre yok)
# Ornek: TELEGRAM_ALLOWED_CHAT_IDS=123456789,-1001234567890
TELEGRAM_ALLOWED_CHAT_IDS=
# Virgulle ayrilmis izinli CORS originleri (bos = localhost varsayilani)
ALLOWED_ORIGINS=

# System
APP_ENV=dev

# Gunluk Telegram ozet raporu saati (yerel saat, 0-23)
DAILY_REPORT_HOUR=21

# Not: Strateji/ticaret parametreleri (leading_indicator, rr_ratio, sl_lookback,
# risk_per_trade, fee_rate, max_leverage, ...) bu dosyada DEGIL; tek kaynak
# `app/strategy/settings.py`'dir. Kalici degisiklikler `app/strategy/settings.json`
# dosyasina persist edilir (dashboard'dan kaydedilince).

# ── Sprint 15-22 yeni parametreler ───────────────────────────────────────────

# Multi-Timeframe sinyal birlestirme (true/false; varsayilan false)
# Diger MTF parametreleri settings.json'dan yonetilir:
#   mtf_enabled, mtf_intervals, mtf_weights
MTF_ENABLED=false

# AI model tipi: dense | lstm | ensemble  (varsayilan dense)
# Bu .env'de ayarlanabilir; yoksa settings.json'daki ai_model_type kullanilir.
AI_MODEL_TYPE=dense

# VaR hesaplama parametreleri (risk.py API ve /var Telegram komutu)
# Guven seviyesi: 0.95 = %95 (varsayilan)
VAR_CONFIDENCE=0.95
# Geriye donuk gun sayisi (varsayilan 30)
VAR_LOOKBACK_DAYS=30

# Makro ekonomik veri (dashboard sekmesi); FMP Free tier
# https://site.financialmodelingprep.com/
FMP_API_KEY=YOUR_FMP_API_KEY
