//@version=5
strategy("XAUUSDT 1m Mean Rev", overlay=true, margin_long=100, margin_short=100,
     initial_capital=1000, default_qty_type=strategy.percent_of_equity,
     default_qty_value=2, pyramiding=1, calc_on_every_tick=true)

slPct   = input.float(6, "SL %", step=0.5)
tpPct   = input.float(3, "TP %", step=0.5)
useMACD = input.bool(true, "MACD Confirmation")
rsiOs   = input.int(30, "RSI Oversold")
rsiOb   = input.int(70, "RSI Overbought")

ema9  = ta.ema(close, 9)
ema21 = ta.ema(close, 21)
rsi   = ta.rsi(close, 14)
[bbU, _, bbL] = ta.bb(close, 20, 2)
[mcd, sig, _] = ta.macd(close, 12, 26, 9)

// Score = 3/4 conditions: RSI + BB + close>open + MACD
longScore  = (rsi < rsiOs ? 1 : 0) + (close <= bbL * 1.001 ? 1 : 0) + (close > open ? 1 : 0) + (useMACD and mcd > sig ? 1 : 0)
shortScore = (rsi > rsiOb ? 1 : 0) + (close >= bbU * 0.999 ? 1 : 0) + (close < open ? 1 : 0) + (useMACD and mcd < sig ? 1 : 0)

entryL = ema9 > ema21 and longScore  >= (useMACD ? 3 : 2)
entryS = ema9 < ema21 and shortScore >= (useMACD ? 3 : 2)

if entryL
    strategy.entry("L", strategy.long)
    strategy.exit("Lx", "L", stop=close*(1-slPct/100), limit=close*(1+tpPct/100))

if entryS
    strategy.entry("S", strategy.short)
    strategy.exit("Sx", "S", stop=close*(1+slPct/100), limit=close*(1-tpPct/100))

plot(ema9,  "EMA9",  #2962FF, 1)
plot(ema21, "EMA21", #FF6B6B, 1)
plot(bbL, "BB Lower", #00C853)
plot(bbU, "BB Upper", #00C853)
hline(rsiOs, "RSI OS", #FF6B6B, hline.style_dashed)
hline(rsiOb, "RSI OB", #2962FF, hline.style_dashed)
